// traza: trazas del kernel desde anillo 3 (OB-01). copihue --flat 0x400000.
// El shell (`traza ...`) escribe la petición de 8 bytes en el archivo tzq
// y corre este programa, que la lee con la syscall 7 en 0x401C00:
//
//   [0] l ls  c count  x clear  p ptr  o on  f off  d dump  z zone
//   [1] sonda (255 = todas)    [2] sonda + 1 (0 = cualquiera)
//   [3] zona + 1               [4] pid + 1       [5] n (1..32)
//
// Usa la syscall 23 (trace_ctl) y la 24 (trace_read); ver docs/trace.md.
// `ptr` prueba que punteros malos den -14 y argumentos malos -22.
// Registros de la syscall 24: 7 i64 (tick, sonda, pid, zona, a, b, tsc) en
// 0x401000 (hasta 32, 1792 bytes). El nombre de una sonda va a 0x401700.
// Sin cadenas: cada palabra es una constante de hasta 8 bytes.

naked fn emit(c: i64) {
    rax = 1;
    syscall();
}

fn say8(w: i64) {
    let x: i64 = w;
    while (x != 0) {
        emit(x & 255);
        x = x >> 8;
    }
}

fn say_num(n: i64) {
    let v: i64 = n;
    if (v < 0) {
        emit(45);
        v = 0 - v;
    }
    let p: i64 = 1;
    while (v / p >= 10) { p = p * 10; }
    while (p > 0) {
        emit(48 + (v / p) % 10);
        p = p / 10;
    }
}

// «trace »
fn w_trace() {
    say8(0x206563617274);
}

// Nombre de la sonda id, leído del kernel.
fn say_name(id: i64) {
    let n: i64 = syscall(23, 5, id, 0x401700);
    let i: i64 = 0;
    while (i < n) {
        emit(*((0x401700 + i) as *u8));
        i = i + 1;
    }
}

fn do_ls() {
    let n: i64 = syscall(23, 4, 0, 0);
    let i: i64 = 0;
    while (i < n) {
        let g: i64 = syscall(23, 1, i, 0);
        say_num(i);
        emit(32);
        say_name(i);
        emit(32);
        if ((g & 1) != 0) { say8(0x6e6f); }
        else { say8(0x66666f); }
        emit(32);
        say_num(g >> 1);
        emit(10);
        i = i + 1;
    }
    w_trace();
    say8(0x2074736f6c);
    say_num(syscall(23, 3, 0, 0) >> 8);
    emit(10);
}

fn do_count() {
    w_trace();
    say8(0x20746e756f63);
    say8(0x2074736f6c);
    say_num(syscall(23, 3, 0, 0) >> 8);
    emit(10);
    let n: i64 = syscall(23, 4, 0, 0);
    let i: i64 = 0;
    while (i < n) {
        say8(0x2065626f7270);
        say_name(i);
        emit(32);
        say_num(syscall(23, 1, i, 0) >> 1);
        emit(10);
        i = i + 1;
    }
}

fn do_dump(sel: i64, max: i64) {
    let got: i64 = syscall(24, 0x401000, max, sel);
    let info: i64 = syscall(23, 3, 0, 0);
    w_trace();
    say8(0x0a6e69676562);
    let i: i64 = 0;
    while (i < got) {
        let b: i64 = 0x401000 + i * 56;
        say8(0x2074);
        say_num(*(b as *i64));
        emit(32);
        say_name(*((b + 8) as *i64));
        say8(0x2064697020);
        say_num(*((b + 16) as *i64));
        say8(0x206120);
        say_num(*((b + 32) as *i64));
        say8(0x206220);
        say_num(*((b + 40) as *i64));
        say8(0x207a20);
        say_num(*((b + 24) as *i64));
        say8(0x206320);
        say_num(*((b + 48) as *i64));
        emit(10);
        i = i + 1;
    }
    w_trace();
    say8(0x206e20646e65);
    say_num(got);
    say8(0x2074736f6c20);
    say_num(info >> 8);
    emit(10);
}

fn do_set(id: i64, on: i64) {
    let r: i64 = syscall(23, 0, id, on);
    if (r != 0) {
        say_num(r);
        emit(10);
        return;
    }
    w_trace();
    if (on != 0) { say8(0x206e6f); }
    else { say8(0x2066666f); }
    if (id == 255) { say8(0x6c6c61); }
    else { say_name(id); }
    emit(10);
}

fn do_clear() {
    syscall(23, 2, 0, 0);
    w_trace();
    say8(0x0a7261656c63);
}

// 1 si la syscall devolvió -e. Dos formas (23 y 24) para no repetir el
// armado de argumentos en cada intento de do_ptr.
fn c24(a: i64, m: i64, s: i64, e: i64) -> i64 {
    if (syscall(24, a, m, s) == 0 - e) { return 1; }
    return 0;
}

fn c23(op: i64, a: i64, b: i64, e: i64) -> i64 {
    if (syscall(23, op, a, b) == 0 - e) { return 1; }
    return 0;
}

// Punteros y argumentos malos: -14 (puntero) y -22 (argumento).
fn do_ptr() {
    let ok: i64 = 1;
    ok = ok & c24(0xFFFFFFFF80400000, 1, 0, 14);
    ok = ok & c24(0xFFFF800000001000, 1, 0, 14);
    ok = ok & c24(1 << 63, 1, 0, 14);
    ok = ok & c24(0x7FFFFFFFFFFFFFFF, 1, 0, 14);
    ok = ok & c24(0x400000, 1, 0, 14);
    ok = ok & c24(0x1000, 1, 0, 14);
    ok = ok & c24(0x401FF8, 1, 0, 14);
    ok = ok & c24(0x401000, 0, 0, 22);
    ok = ok & c24(0x401000, 33, 0, 22);
    ok = ok & c24(0x401000, 1, 0 - 1, 22);
    ok = ok & c23(5, 0, 0xFFFFFFFF80400000, 14);
    ok = ok & c23(5, 0, 0x400000, 14);
    ok = ok & c23(5, 0, 0x401FF8, 14);
    ok = ok & c23(5, 99, 0x401700, 22);
    ok = ok & c23(0, 20, 1, 22);
    ok = ok & c23(9, 0, 0, 22);
    if (syscall(24, 0x401000, 1, 0) < 0) { ok = 0; }
    if (ok == 1) { say8(0x0a6b6f20727470); }
    else { say8(0x0a64616220727470); }
}

// El proceso (zona 0) se pasa a la zona t con la syscall 9 y de ahí pide
// la syscall 23, que la máscara de la zona niega: «traza zone 0 deny -1».
fn do_zone(t: i64) {
    let r: i64 = syscall(9, t);
    let d: i64 = syscall(23, 4, 0, 0);
    say8(0x7a20617a617274);
    say8(0x20656e6f);
    say_num(r);
    say8(0x20796e656420);
    say_num(d);
    emit(10);
}

fn run() {
    let op: i64 = *(0x401C00 as *u8);
    op = op & 255;
    let a: i64 = *(0x401C01 as *u8);
    a = a & 255;
    if (op == 108) { do_ls(); }
    if (op == 99) { do_count(); }
    if (op == 120) { do_clear(); }
    if (op == 112) { do_ptr(); }
    if (op == 111) { do_set(a, 1); }
    if (op == 102) { do_set(a, 0); }
    if (op == 122) { do_zone(a); }
    if (op == 100) {
        let e: i64 = *(0x401C02 as *u8);
        let z: i64 = *(0x401C03 as *u8);
        let p: i64 = *(0x401C04 as *u8);
        let n: i64 = *(0x401C05 as *u8);
        do_dump((e & 255) | ((z & 255) << 8) | ((p & 255) << 16), n & 255);
    }
}

naked fn _start() {
    *(0x401800 as *u8) = 116;
    *(0x401801 as *u8) = 122;
    *(0x401802 as *u8) = 113;
    *(0x401803 as *u8) = 0;
    rax = 7;
    rdi = 64;
    syscall();
    if (rax >= 1) { run(); }
    rax = 5;
    syscall();
    hlt();
}
