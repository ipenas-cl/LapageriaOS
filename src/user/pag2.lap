// Programa de tres páginas (EX-02, EX-05). Se compila con
//
//   copihue --flat 0x400000 --axe2 -o pag2.axe pag2.lap
//
// y el compilador entrega el AXE2 completo (Copihue v0.44.1): texto, datos
// iniciales de los `let` globales y bss. Nada se arma a mano en el Makefile.
//
//   0x400000  texto, página 0 (_start y el resto): lectura y ejecución
//   0x401000  texto, página 1: `where`, con align(4096): lectura y ejecución
//   0x402000  datos (los `let` con valor) y justo detrás la bss (los `let` sin
//             valor), hasta 0x403000: lectura y escritura, sin ejecución
//   0x410000  página de E/S      0x411000  guarda    0x412000  pila
//
// La página de datos trae "SEG2" en el byte 0, DE AD BE EF en el 4 y 0x5A en
// el 8; el resto de la página (la bss) está en cero. Pasos:
//
//   1 lee los marcadores por dirección y por nombre
//   2 comprueba que el resto de la página está en cero
//   3 escribe la página entera por dirección y la lee de vuelta
//   4 lee por nombre (datos y bss) lo que se escribió por dirección
//   5 escribe por nombre, también la bss, y lo lee por dirección
//   6 llama a `where`, que está en la segunda página de texto, y comprueba que
//     la dirección donde corre es 0x401000 (sale de `lea rax, [rel $]`)
//   7 escribe y lee la página de E/S (0x410000)
//
// Imprime `pag2 ok`, o `pag2 fail N` con el paso que falló. Sin cadenas:
// cada mensaje va por la syscall 1, de a 8 bytes (say8).

let mark_a: [u8; 4] = [0x53, 0x45, 0x47, 0x32];
let mark_b: [u8; 4] = [0xDE, 0xAD, 0xBE, 0xEF];
let mark_c: [u8; 4] = [0x5A, 0, 0, 0];
let rest: [u8; 4084];

naked fn emit(c: i64) {
    rax = 1;
    syscall();
}

fn say8(w: i64) {
    let x: i64 = w;
    while (x != 0) {
        emit(x & 255);
        x = x >> 8;
    }
}

fn say_ok() {
    say8(0x0a6b6f2032676170);
}

fn say_fail(n: i64) {
    say8(0x6961662032676170);
    emit(108);
    emit(32);
    emit(48 + n);
    emit(10);
}

fn get(a: i64) -> i64 {
    let p: *u8 = a as *u8;
    let v: i64 = p[0];
    return v & 255;
}

fn put(a: i64, v: i64) {
    let p: *u8 = a as *u8;
    p[0] = v as u8;
}

// Byte `off` de la página de datos, por nombre. Los 12 primeros bytes son los
// tres `let` con valor; del 12 en adelante es la bss.
fn named(off: i64) -> i64 {
    if (off < 4) { return mark_a[off] & 255; }
    if (off < 8) { return mark_b[off - 4] & 255; }
    if (off < 12) { return mark_c[off - 8] & 255; }
    return rest[off - 12] & 255;
}

fn set_named(off: i64, v: i64) {
    if (off < 4) { mark_a[off] = v as u8; return; }
    if (off < 8) { mark_b[off - 4] = v as u8; return; }
    if (off < 12) { mark_c[off - 8] = v as u8; return; }
    rest[off - 12] = v as u8;
}

// 1 si el byte `off` de la página de datos es uno de los marcadores.
fn marked(off: i64) -> i64 {
    if (off < 8) { return 1; }
    if (off == 8) { return 1; }
    return 0;
}

fn check_marks() -> i64 {
    if (get(0x402000) != 0x53 || get(0x402001) != 0x45) { return 1; }
    if (get(0x402002) != 0x47 || get(0x402003) != 0x32) { return 1; }
    if (get(0x402004) != 0xDE || get(0x402005) != 0xAD) { return 1; }
    if (get(0x402006) != 0xBE || get(0x402007) != 0xEF) { return 1; }
    if (get(0x402008) != 0x5A) { return 1; }
    if (mark_a[0] != 0x53 || mark_a[3] != 0x32) { return 1; }
    if (mark_b[0] != 0xDE || mark_b[3] != 0xEF) { return 1; }
    if (mark_c[0] != 0x5A) { return 1; }
    return 0;
}

fn check_rest() -> i64 {
    let k: i64 = 0;
    while (k < 4096) {
        if (marked(k) == 0 && get(0x402000 + k) != 0) { return 2; }
        if (marked(k) == 0 && named(k) != 0) { return 2; }
        k = k + 1;
    }
    return 0;
}

fn write_raw() -> i64 {
    let k: i64 = 0;
    while (k < 4096) {
        put(0x402000 + k, (k * 5 + 1) & 255);
        k = k + 1;
    }
    k = 0;
    while (k < 4096) {
        if (get(0x402000 + k) != ((k * 5 + 1) & 255)) { return 3; }
        k = k + 1;
    }
    return 0;
}

// Lo escrito por dirección se ve por nombre, en datos y en bss.
fn read_named() -> i64 {
    let k: i64 = 0;
    while (k < 4096) {
        if (named(k) != ((k * 5 + 1) & 255)) { return 4; }
        k = k + 1;
    }
    return 0;
}

// Lo escrito por nombre se ve por dirección.
fn write_named() -> i64 {
    let k: i64 = 0;
    while (k < 4096) {
        set_named(k, (k ^ 0x3C) & 255);
        k = k + 1;
    }
    k = 0;
    while (k < 4096) {
        if (get(0x402000 + k) != ((k ^ 0x3C) & 255)) { return 5; }
        k = k + 1;
    }
    return 0;
}

// Está en la segunda página de texto: align(4096) la deja en 0x401000.
// Devuelve la dirección donde corre.
align(4096) naked fn where() -> i64 {
    asm("lea rax, [rel $]");
}

fn second_page() -> i64 {
    let a: i64 = where();
    if (a != 0x401000) { return 6; }
    return 0;
}

fn io_page() -> i64 {
    put(0x410000, 0x42);
    put(0x410FFF, 0x24);
    if (get(0x410000) != 0x42 || get(0x410FFF) != 0x24) { return 7; }
    return 0;
}

fn pag2_main() {
    let r: i64 = check_marks();
    if (r == 0) { r = check_rest(); }
    if (r == 0) { r = write_raw(); }
    if (r == 0) { r = read_named(); }
    if (r == 0) { r = write_named(); }
    if (r == 0) { r = second_page(); }
    if (r == 0) { r = io_page(); }
    if (r == 0) { say_ok(); } else { say_fail(r); }
}

naked fn _start() {
    pag2_main();
    rax = 5;
    syscall();
    hlt();
}
