// Eco UDP de anillo 3 (RD-01). copihue --flat 0x400000.
// Abre el puerto 7777 con la syscall 12 (devuelve el fd 0). Si el kernel
// la niega (zona sin red) imprime `udp denied` y sale. Si no, primero
// prueba punteros malos contra las syscalls 13 y 14 (kernel, MMIO, página
// de código, cruzando el final de la pila): todos tienen que dar -14 y
// entonces imprime `udp ptr denied`. Después duerme en recv hasta 5 s (500
// ticks) y devuelve el datagrama a quien lo mandó: `udp echo ok`.
// ABI de la parte 2: send(fd, buf, largo, dst), recv(fd, buf, max, src,
// plazo). El buffer es 0x401A00 y la fuente (ip << 16 | puerto) 0x401900,
// en la página de la pila. Sin cadenas: cada mensaje va por la syscall 1,
// de a 8 bytes (say8) con el primero en el byte bajo.

naked fn emit(c: i64) {
    rax = 1;
    syscall();
}

fn say8(w: i64) {
    let x: i64 = w;
    while (x != 0) {
        emit(x & 255);
        x = x >> 8;
    }
}

fn w_udp() {
    say8(0x20706475);
}

fn say_denied() {
    w_udp();
    say8(0x0a6465696e6564);
}

fn say_listen() {
    w_udp();
    say8(0x0a6e657473696c);
}

fn say_ok() {
    w_udp();
    say8(0x0a6b6f206f686365);
}

fn say_timeout() {
    w_udp();
    say8(0x0a74756f656d6974);
}

fn say_ptr() {
    w_udp();
    say8(0x20727470);
    say8(0x0a6465696e6564);
}

// 1 si la syscall n con esos argumentos dio -14.
fn bad(n: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 {
    let r: i64 = syscall(n, a1, a2, a3, a4, a5);
    if (r == 0 - 14) { return 1; }
    return 0;
}

fn ptr_attacks() {
    // 0 - 0x7FC00000 es 0xFFFFFFFF80400000, el texto del kernel.
    let k: i64 = 0 - 0x7FC00000;
    let dst: i64 = (0x0A000202 << 16) | 1234;
    let ok: i64 = 1;
    ok = ok & bad(14, 0, k, 16, 0, 0);
    ok = ok & bad(14, 0, 0x401A00, 16, k, 0);
    ok = ok & bad(13, 0, k, 16, dst, 0);
    ok = ok & bad(13, 0, 0x1000, 16, dst, 0);
    ok = ok & bad(14, 0, 0x10000000, 16, 0, 0);
    ok = ok & bad(14, 0, 0x400000, 16, 0, 0);
    ok = ok & bad(13, 0, 0x401FF8, 16, dst, 0);
    ok = ok & bad(14, 0, 0x401FF8, 16, 0, 0);
    if (ok == 1) { say_ptr(); }
}

fn listen_and_echo() {
    say_listen();
    let n: i64 = syscall(14, 0, 0x401A00, 256, 0x401900, 500);
    if (n < 0) {
        say_timeout();
    } else {
        let dst: i64 = *(0x401900 as *i64);
        let s: i64 = syscall(13, 0, 0x401A00, n, dst, 0);
        if (s == 0) { say_ok(); }
    }
    syscall(15, 0);
}

fn echo_main() {
    let fd: i64 = syscall(12, 7777);
    if (fd != 0) {
        say_denied();
    } else {
        ptr_attacks();
        listen_and_echo();
    }
}

naked fn _start() {
    echo_main();
    rax = 5;
    syscall();
    hlt();
}
