// Programa de ataque de la zona (SG-01 parte 2). copihue --flat 0x400000.
// Corre en anillo 3 dentro de una zona y hace UN ataque contra la memoria.
// El modo sale del archivo `q` de la zona (0x401800 nombre, 0x401C00 datos):
// el shell lo escribe con `fs write zkq N` antes de cada `zone exec`.
//
//   '1' leer el texto del kernel (0xFFFFFFFF80400000)
//   '2' escribir ahí
//   '3' leer la mitad alta 0xFFFF800000001000 (alias de las tablas)
//   '4' escribir ahí
//   '5' leer 0x1000, físico de las tablas, en la identidad baja
//   '6' ejecutar la pila (NX)
//   '7' ejecutar una página pedida con la syscall 8 (NX)
//   '8' escribir su propia página de código (sin escritura)
//   '9' ejecutar el texto del kernel
//   'a' leer una dirección no canónica (#GP)
//   'b' leer una página de usuario que no existe
//   'd' punteros del kernel como argumento de las syscalls 6 y 7
//   'u' ud2 (#UD)
//   'z' INT64_MIN / -1 (#DE; `/` tiene guarda para x / 0)
//   'r' div_raw(1, 0) (#DE por divisor cero)
//   'm' rem_raw(1, 0) (#DE por divisor cero)
//   'i' int 3 (la puerta de la IDT es DPL 0: da #GP, no #BP)
//
// EX-04: la pila de un AXE1 está en 0x40F000 (tope 0x410000) con una guarda
// sin mapa en 0x40E000, aparte de la página de E/S (0x401000).
//   's' desbordar la pila con una recursión sin fin (cae en la guarda)
//   't' leer el primer byte de la guarda
//   'v' rsp dentro de la guarda y un push
//
// Cada ataque tiene que matar al proceso con un fallo, así que el mensaje
// `atk survived` solo sale si el kernel NO lo negó. Los mensajes comparten
// letras para caber en 4080 bytes (mkaxe.sh).

naked fn emit(c: i64) {
    rax = 1;
    syscall();
}

naked fn nl() {
    emit(10);
}

// Salta a la dirección de rdi. Sin locales: un naked no tiene pila propia.
naked fn jump_to(a: i64) {
    jmp rdi;
}

// Pone rsp en a y empuja: el push escribe en a - 8.
naked fn sp_push(a: i64) {
    rsp = rdi;
    push(0);
}

// Recursión sin fin: cada marco guarda n en la pila.
fn deep(n: i64) -> i64 {
    let pad: i64 = n;
    return deep(n + 1) + pad;
}

// atk <modo>
fn say_atk(m: i64) {
    emit(97);
    emit(116);
    emit(107);
    emit(32);
    emit(m);
    nl();
}

// atk survived
fn say_survived() {
    emit(97);
    emit(116);
    emit(107);
    emit(32);
    emit(115);
    emit(117);
    emit(114);
    emit(118);
    emit(105);
    emit(118);
    emit(101);
    emit(100);
    nl();
}

// zone ptr denied
fn say_ptr() {
    emit(122);
    emit(111);
    emit(110);
    emit(101);
    emit(32);
    emit(112);
    emit(116);
    emit(114);
    emit(32);
    emit(100);
    emit(101);
    emit(110);
    emit(105);
    emit(101);
    emit(100);
    nl();
}

// Lectura de syscall 7 con punteros del kernel en rsi y rdx. El kernel
// no los usa: el nombre y los datos salen de 0x401800 y 0x401C00.
naked fn read_ptrs() {
    rax = 7;
    rdi = 8;
    rsi = 0xFFFFFFFF80400000;
    rdx = 0xFFFF800000001000;
    syscall();
}

// (e) Un largo que es un puntero del kernel se rechaza con -9. La lectura
// recorta a 64 un largo positivo enorme: devuelve 1 (el archivo mide 1 byte)
// y no copia nada de más.
fn ptr_attack() {
    let ok: i64 = 1;
    if (syscall(6, 0xFFFFFFFF80400000) != 0 - 9) { ok = 0; }
    if (syscall(6, 0xFFFF800000001000) != 0 - 9) { ok = 0; }
    if (syscall(6, 0x7FFFFFFFFFFFFFFF) != 0 - 9) { ok = 0; }
    if (syscall(7, 0xFFFFFFFF80400000) != 0 - 9) { ok = 0; }
    if (syscall(7, 0xFFFF800000001000) != 0 - 9) { ok = 0; }
    if (syscall(7, 1 << 63) != 0 - 9) { ok = 0; }
    if (syscall(7, 0x7FFFFFFFFFFFFFFF) != 1) { ok = 0; }
    *(0x401C00 as *u8) = 0;
    let n: i64 = read_ptrs();
    if (n != 1) { ok = 0; }
    if (*(0x401C00 as *u8) != 100) { ok = 0; }
    if (ok == 1) { say_ptr(); }
    else { say_survived(); }
}

fn attack(m: i64) {
    let x: i64 = 0;
    if (m == 49) { x = *(0xFFFFFFFF80400000 as *u8); }
    if (m == 50) { *(0xFFFFFFFF80400000 as *u8) = 0x90; }
    if (m == 51) { x = *(0xFFFF800000001000 as *u8); }
    if (m == 52) { *(0xFFFF800000001000 as *u8) = 0; }
    if (m == 53) { x = *(0x1000 as *u8); }
    if (m == 54) { jump_to(0x401800); }
    if (m == 55) {
        if (syscall(8) == 0) { jump_to(0x402000); }
    }
    if (m == 56) { *(0x400000 as *u8) = 0; }
    if (m == 57) { jump_to(0xFFFFFFFF80400000); }
    if (m == 97) { x = *((1 << 63) as *u8); }
    if (m == 98) { x = *(0x500000 as *u8); }
    // SG-02: excepciones de CPU que no son #PF ni #GP de memoria.
    if (m == 117) { ud2(); }
    if (m == 122) {
        // `/` tiene guarda (x / 0 es 0). INT64_MIN / -1 desborda el
        // cociente y el idiv da #DE. Los operandos salen de memoria. El
        // `0 - *u8` toma el ancho de d (i64): vale -1, no 255.
        *(0x401C20 as *u8) = 1;
        let one: i64 = *(0x401C20 as *u8);
        let d: i64 = 0 - *(0x401C20 as *u8);
        let n: i64 = one << 63;
        x = n / d;
    }
    // Divisor cero sin guarda: div_raw / rem_raw dejan el idiv pelado y
    // el #DE sale por b == 0.
    if (m == 114) {
        *(0x401C20 as *u8) = 0;
        let z: i64 = *(0x401C20 as *u8);
        x = div_raw(1, z);
    }
    if (m == 109) {
        *(0x401C20 as *u8) = 0;
        let z: i64 = *(0x401C20 as *u8);
        x = rem_raw(1, z);
    }
    if (m == 105) { int(3); }
    if (m == 115) { x = deep(0); }
    if (m == 116) { x = *(0x40E000 as *u8); }
    if (m == 118) { sp_push(0x40E800); }
    if (x == 123456) { emit(88); }
    say_survived();
}

fn run_mode() {
    let m: i64 = *(0x401C00 as *u8);
    m = m & 255;
    say_atk(m);
    if (m == 100) {
        ptr_attack();
        return;
    }
    attack(m);
}

naked fn _start() {
    *(0x401800 as *u8) = 113;
    *(0x401801 as *u8) = 0;
    rax = 7;
    rdi = 1;
    syscall();
    if (rax == 1) { run_mode(); }
    rax = 5;
    syscall();
    hlt();
}
