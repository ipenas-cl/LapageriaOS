// LapageriaOS: stub UEFI (HR-01). NO es el kernel: es la prueba de que
// el firmware (OVMF en QEMU) carga y ejecuta una aplicación EFI escrita en
// Copihue. Imprime una línea por la consola del firmware (ConOut) y por
// COM1, y apaga la máquina con RuntimeServices->ResetSystem. El kernel de
// LapageriaOS sigue arrancando solo por BIOS; ver docs/hr01-uefi-ahci.md.
//
// Se compila con `copihue --flat 0x1000` y scripts/mkpe.sh / src/uefi/pe.asm
// lo envuelven en un PE32+ (BOOTX64.EFI, subsistema 10). 0x1000 es el RVA de
// .text; el entry es el primer byte (`_start`).
//
// Es independiente de la posición: ninguna global, ninguna cadena de Copihue
// (esas se direccionan en absoluto). Los datos van en bloques `data` y se
// alcanzan con `lea reg, [rel etiqueta]`. Así el cargador puede ponerlo en
// cualquier dirección sin relocaciones (pe.asm trae una tabla vacía).
//
// ABI: UEFI usa Microsoft x64 (rcx, rdx, r8, r9 + 32 bytes de sombra); Copihue
// usa System V. El paso de una a otra son los tres `naked fn`.

// Entrada. rcx = ImageHandle, rdx = EFI_SYSTEM_TABLE*. Al entrar rsp = 8 mod 16;
// los 40 bytes dejan la pila alineada a 16 en la llamada y los 32 de sombra.
naked fn _start() {
    asm("mov rdi, rdx; lea rsi, [rel efi_msg8]; lea rdx, [rel efi_msg16]; sub rsp, 40; call efi_main; add rsp, 40; ret");
}

// Los dos siguientes alinean la pila a 16 (el código de Copihue no lo
// garantiza y el firmware usa movaps) y reservan la sombra de 32 bytes.
// fp(a, b) con ABI MS: rcx = a, rdx = b. Parámetros SysV: rdi = fp, rsi = a, rdx = b.
naked fn efi_call2(fp: i64, a: i64, b: i64) -> i64 {
    asm("mov rax, rdi; mov rcx, rsi; push rbp; mov rbp, rsp; and rsp, -16; sub rsp, 32; call rax; leave; ret");
}

// fp(a, b, c, d) con ABI MS. SysV: rdi = fp, rsi = a, rdx = b, rcx = c, r8 = d.
naked fn efi_call4(fp: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    asm("mov rax, rdi; mov r9, r8; mov r8, rcx; mov rcx, rsi; push rbp; mov rbp, rsp; and rsp, -16; sub rsp, 32; call rax; leave; ret");
}

data efi_msg8 { db "LapageriaOS UEFI stub ok\r\n", 0; }

// "LapageriaOS UEFI stub ok\r\n" en UTF-16LE, terminada en 0.
data efi_msg16 {
    dw 76, 97, 112, 97, 103, 101, 114, 105, 97, 79, 83, 32, 85, 69, 70, 73, 32, 115, 116, 117, 98, 32, 111, 107, 13, 10, 0;
}

fn efi_com1(s: *u8) -> i64 {
    let i = 0;
    while (s[i] != 0) {
        while ((inb(0x3FD) & 0x20) == 0) { pause(); }
        outb(0x3F8, s[i] & 255);
        i = i + 1;
    }
    return 0;
}

// EFI_SYSTEM_TABLE: ConOut en +0x40, RuntimeServices en +0x58.
// EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL.OutputString en +8.
// EFI_RUNTIME_SERVICES.ResetSystem en +0x68.
fn efi_main(systab: i64, msg8: *u8, msg16: i64) -> i64 {
    efi_com1(msg8);
    let st: *i64 = systab as *i64;
    let conout = st[8];
    let co: *i64 = conout as *i64;
    efi_call2(co[1], conout, msg16);
    let rt: *i64 = st[11] as *i64;
    // ResetSystem(EfiResetShutdown = 2, EFI_SUCCESS, 0, NULL)
    efi_call4(rt[13], 2, 0, 0, 0);
    while (1) {
        cli();
        hlt();
    }
    return 0;
}
