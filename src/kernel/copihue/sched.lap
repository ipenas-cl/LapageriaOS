// Two user processes. Each has its own PML4. PML4[256..511] all point at
// one shared kernel PDPT, without the user bit. Slot 0 of that PDPT is
// the old alias of the low 2MB at 0xFFFF800000000000 (whatever
// kern_low_pt still maps; the kernel image is gone from it). Slot 510
// is the higher-half window at 0xFFFFFFFF80000000, the same PD the
// bootloader built at physical 0x5000. The kernel runs there. PML4[0]
// is private. Its PD[0] still points at kern_low_pt so a process can
// use the low half; ring 3 does not see the kernel pages.
//
// The PIT IRQ from ring 3 lands on TSS.rsp0. yield and the timer share
// one iretq frame: 15 saved GPRs, then RIP, CS, RFLAGS, RSP, SS.

extern __syscall_rsp;

let volatile sched_on: i64 = 0;
let volatile cur_i: i64 = 0;
let volatile saved_cs: i64 = 0;
let volatile saved_ksp: i64 = 0;
let volatile patch_rip: i64 = 0;
let volatile nswitch_timer: i64 = 0;
let volatile nswitch_yield: i64 = 0;
let volatile uctx_rip: i64 = 0;
let volatile uctx_rsp: i64 = 0;
let volatile uctx_rfl: i64 = 0;
let volatile alias_ptr: i64 = 0;
let volatile alias_byte: i64 = 0;
let alias_b0: i64 = 0;
let alias_b1: i64 = 0;
let alias_b7: i64 = 0;

let proc_pid: [i64; 2];
let proc_state: [i64; 2];
let proc_pml4: [i64; 2];
let proc_rsp0: [i64; 2];
let proc_ksp: [i64; 2];
let proc_sys: [i64; 2];
let proc_npages: [i64; 2];
let proc_freed: [i64; 2];
let proc_pages: [i64; 64];
let user_kills: i64 = 0;
// Cambios de contexto entre procesos (switch_to y la salida de un proceso
// con el otro vivo) y cuántos cambiaron la zona activa. `zone pair` los
// pone en cero antes de correr.
let volatile zsw_n: i64 = 0;
let volatile zsw_chg: i64 = 0;
let proc_rec0: [i64; 2];
let proc_rec1: [i64; 2];
let proc_faults: [i64; 2];
let proc_zone: [i64; 2];
let proc_held: [i64; 2];
let proc_uva: [i64; 2];
// 1: la salida del proceso (syscall 1) sale por líneas enteras (usermode.lap).
// Solo los programas del disco; las demos de `sched`, `nx` y `hh` se quedan
// con salida carácter a carácter porque la prueba usa la mezcla de sus letras
// como prueba de que el PIT los alterna.
let proc_lbuf: [i64; 2];
let shared_pdpt: i64 = 0;
let shared_pd: i64 = 0;
let sched_base: i64 = 0;
let released_ok: i64 = 0;

fn track(pi: i64, pa: i64) -> i64 {
    if (pa == 0) { return 0; }
    let n = proc_npages[pi];
    if (n < 0 || n >= 32) { return 0; }
    proc_pages[pi * 32 + n] = pa;
    proc_npages[pi] = n + 1;
    return pa;
}

fn take_page(pi: i64, low: i64) -> i64 {
    let pa = 0;
    if (low != 0) { pa = alloc_low_page(); } else { pa = alloc_high_page(); }
    if (pa == 0) { return 0; }
    if (track(pi, pa) == 0) {
        free_page(pa);
        return 0;
    }
    return pa;
}

fn take_table(pi: i64) -> i64 {
    let pa = take_page(pi, 1);
    if (pa == 0) { return 0; }
    zero_va(pa);
    return pa;
}

fn map_user(pi: i64, va: i64, pa: i64, flags: i64) -> i64 {
    if (map_in(proc_pml4[pi], va, pa, flags) == 0) { return 0; }
    if (last_alloc_pt != 0) {
        if (track(pi, last_alloc_pt) == 0) { return 0; }
    }
    return 1;
}

fn pml4_slot(pi: i64, i: i64) -> i64 {
    let p: *u64 = proc_pml4[pi] as *u64;
    return p[i];
}

fn shared_init() -> i64 {
    if (shared_pdpt != 0) { return 1; }
    shared_pdpt = alloc_low_page();
    shared_pd = alloc_low_page();
    if (shared_pdpt == 0 || shared_pd == 0) { return 0; }
    zero_va(shared_pdpt);
    zero_va(shared_pd);
    let pdpt: *u64 = shared_pdpt as *u64;
    let pd: *u64 = shared_pd as *u64;
    pdpt[0] = shared_pd | 3;
    pd[0] = low_pd_entry();
    // Misma PD física que PML4[511] del arranque. Sin bit de usuario.
    pdpt[510] = 0x5000 | 3;
    return 1;
}

fn attach_half(pml4pa: i64) -> i64 {
    let p: *u64 = pml4pa as *u64;
    let i = 256;
    while (i < 512) {
        p[i] = shared_pdpt | 3;
        i = i + 1;
    }
    return p[256];
}

fn other_runnable(me: i64) -> i64 {
    let i = 0;
    while (i < 2) {
        if (i != me && (proc_state[i] == 1 || proc_state[i] == 2)) { return i; }
        i = i + 1;
    }
    return -1;
}

// Como other_runnable, pero cuenta también al proceso dormido en recv
// (estado 4): sigue vivo y tiene marco forjado. exit_current lo usa para
// no dejar a un dormido sin CPU cuando el otro termina.
fn other_alive(me: i64) -> i64 {
    let i = 0;
    while (i < 2) {
        if (i != me && (proc_state[i] == 1 || proc_state[i] == 2 || proc_state[i] == 4)) { return i; }
        i = i + 1;
    }
    return -1;
}

// rsp0 is the empty kernel stack. The interrupt epilogue pops 15 GPRs
// and iretq's, which is 160 bytes below that top.
fn forge(pi: i64, rip: i64, rsp: i64, rfl: i64) -> i64 {
    let base = proc_rsp0[pi] - 160;
    let s: *u64 = base as *u64;
    let i = 0;
    while (i < 15) {
        s[i] = 0;
        i = i + 1;
    }
    s[15] = rip;
    s[16] = 0x3B;
    s[17] = rfl;
    s[18] = rsp;
    s[19] = 0x33;
    proc_ksp[pi] = base;
    return base;
}

// La zona activa es la del proceso que corre (0 con el planificador
// apagado). Cada cambio de contexto pasa por aquí: cuenta, y si la zona
// activa cambia deja zone-switch (sonda 18) con la zona de salida y la
// de entrada. pid es el del proceso que deja la CPU.
fn zone_note_switch(pid: i64, fz: i64, tz: i64) -> i64 {
    zsw_n = zsw_n + 1;
    if (fz == tz) { return 0; }
    zsw_chg = zsw_chg + 1;
    if (tr_en[18] != 0) { trace_hit_z(18, pid, fz, fz, tz); }
    return 0;
}

fn switch_to(n: i64) -> i64 {
    let from = proc_pid[cur_i];
    let to = proc_pid[n];
    let fz = proc_zone[cur_i];
    proc_state[cur_i] = 1;
    proc_state[n] = 2;
    cur_i = n;
    tss.rsp0 = proc_rsp0[n];
    set_syscall_stack(proc_sys[n]);
    write_cr3(proc_pml4[n]);
    saved_ksp = proc_ksp[n];
    // switch: el proceso es el que deja la CPU; argumentos, origen y destino.
    if (tr_en[2] != 0) { trace_hit_z(2, from, fz, from, to); }
    zone_note_switch(from, fz, proc_zone[n]);
    return 0;
}

// ---- cuota de CPU por zona (FS-04/3, docs/zonas.md) ----
// Ventana fija de 20 ticks del PIT. zcpu_q[z] son los ticks por ventana que
// la zona z puede gastar (0 = sin límite); zcpu_use[z] los que lleva en la
// ventana. Un tick se le cobra a la zona del proceso que corría. Con la
// cuota gastada, la zona cede la CPU al otro proceso hasta que la ventana
// se renueva (en el tick 20). Es un tope duro (FS-05/1): si no hay otro
// proceso con cuota, la CPU pasa a la tarea ociosa (idle_loop: hlt sobre su
// propia pila) hasta que la ventana se renueve. zcpu_idle y zcpu_solo
// cuentan los ticks ociosos y los cobrados sin otro proceso listo.
// Todo se mide en ticks (no en tiempo del anfitrión), y los contadores son
// los que mira la prueba: zcpu_tot (ticks cobrados), zcpu_cont (los cobrados
// con otro proceso listo) y zcpu_thr (veces que la cuota la sacó de la CPU).
let zcpu_q: [i64; 8];
let zcpu_use: [i64; 8];
let zcpu_tot: [i64; 8];
let zcpu_cont: [i64; 8];
let zcpu_thr: [i64; 8];
let zcpu_idle: [i64; 8];
let zcpu_solo: [i64; 8];
let volatile zcpu_win: i64 = 0;
let volatile idle_on: i64 = 0;
let idle_stack: [u8; 4096];

fn zcpu_throttled(z: i64) -> i64 {
    if (z < 1 || z >= 8) { return 0; }
    if (zcpu_q[z] <= 0) { return 0; }
    return zcpu_use[z] >= zcpu_q[z];
}

// Syscall 28 cpu_ticks: los ticks que se han cobrado a la zona del que llama
// (zcpu_tot). Solo lee el contador propio; sirve para que un programa gaste
// CPU hasta cierto número de ticks en vez de cierto número de vueltas.
fn zcpu_sys_ticks() -> i64 {
    let z = proc_zone[cur_i];
    if (z < 0 || z >= 8) { return 0; }
    return zcpu_tot[z];
}

fn zcpu_reset(z: i64) -> i64 {
    zcpu_q[z] = 0;
    zcpu_use[z] = 0;
    zcpu_tot[z] = 0;
    zcpu_cont[z] = 0;
    zcpu_thr[z] = 0;
    zcpu_idle[z] = 0;
    zcpu_solo[z] = 0;
    return 0;
}

// Ventana nueva: la corrida empieza con todas las zonas sin gasto.
fn zcpu_window_start() -> i64 {
    zcpu_win = 0;
    idle_on = 0;
    let i = 0;
    while (i < 8) {
        zcpu_use[i] = 0;
        i = i + 1;
    }
    return 0;
}

// Un tick del PIT con el planificador prendido: cobra al proceso que corría
// y renueva la ventana cada 20 ticks.
fn zcpu_tick() -> i64 {
    if (proc_state[cur_i] == 2) {
        let z = proc_zone[cur_i];
        if (z >= 0 && z < 8) {
            zcpu_use[z] = zcpu_use[z] + 1;
            zcpu_tot[z] = zcpu_tot[z] + 1;
            if (other_runnable(cur_i) >= 0) {
                zcpu_cont[z] = zcpu_cont[z] + 1;
            } else {
                zcpu_solo[z] = zcpu_solo[z] + 1;
            }
        }
    } else if (idle_on != 0) {
        // Tarea ociosa: el tick no se cobra a nadie; se anota a la zona
        // que espera con la cuota agotada.
        let zi = proc_zone[cur_i];
        if (zi >= 0 && zi < 8) { zcpu_idle[zi] = zcpu_idle[zi] + 1; }
    }
    zcpu_win = zcpu_win + 1;
    if (zcpu_win >= 20) {
        zcpu_win = 0;
        let i = 0;
        while (i < 8) {
            zcpu_use[i] = 0;
            i = i + 1;
        }
    }
    return 0;
}

// Proceso que puede correr ahora: listo (1) o corriendo (2), con marco
// forjado y con la cuota de su zona sin agotar. -1 si no hay ninguno.
fn eligible_proc() -> i64 {
    let i = 0;
    while (i < 2) {
        if ((proc_state[i] == 1 || proc_state[i] == 2) && proc_ksp[i] != 0 && zcpu_throttled(proc_zone[i]) == 0) { return i; }
        i = i + 1;
    }
    return -1;
}

// Marco de la tarea ociosa: iretq a anillo 0 (CS 0x18, SS 0x20) sobre su
// propia pila, con IF prendido. Devuelve la base del marco (20 qwords).
fn idle_forge() -> i64 {
    let top = (idle_stack as i64) + 4096;
    let base = top - 160;
    let s: *u64 = base as *u64;
    let i = 0;
    while (i < 15) {
        s[i] = 0;
        i = i + 1;
    }
    s[15] = &idle_loop;
    s[16] = 0x18;
    s[17] = 0x202;
    s[18] = top;
    s[19] = 0x20;
    return base;
}

fn idle_loop() -> i64 {
    while (1) { hlt(); }
    return 0;
}

// Tope duro (FS-05/1). Dos casos en el tick del PIT:
//  - Tarea ociosa activa: si ya hay un proceso con cuota disponible (la
//    ventana se renovó, o despertó otro), se lo reanuda.
//  - El proceso en anillo 3 agotó la cuota: pasa a otro proceso con cuota o,
//    si no hay, a la tarea ociosa (hlt hasta que la ventana se renueve).
// Devuelve 1 si cambió saved_ksp (el manejador del PIT cambia el marco).
fn timer_idle_switch() -> i64 {
    if (idle_on != 0) {
        let e = eligible_proc();
        if (e < 0) { return 0; }
        idle_on = 0;
        if (e != cur_i) {
            switch_to(e);
        } else {
            proc_state[e] = 2;
            saved_ksp = proc_ksp[e];
        }
        return 1;
    }
    if (zcpu_throttled(proc_zone[cur_i]) == 0) { return 0; }
    let z = proc_zone[cur_i];
    zcpu_thr[z] = zcpu_thr[z] + 1;
    proc_ksp[cur_i] = saved_ksp;
    let e2 = eligible_proc();
    if (e2 >= 0) {
        switch_to(e2);
        nswitch_timer = nswitch_timer + 1;
        return 1;
    }
    proc_state[cur_i] = 1;
    idle_on = 1;
    saved_ksp = idle_forge();
    return 1;
}

fn timer_should_switch() -> i64 {
    if (sched_on == 0) { return 0; }
    if (idle_on != 0) { return timer_idle_switch(); }
    if ((saved_cs & 3) != 3) { return 0; }
    // Cuota agotada: otro proceso con cuota o tarea ociosa, aunque nadie
    // más espere.
    if (zcpu_throttled(proc_zone[cur_i]) != 0) { return timer_idle_switch(); }
    let n = other_runnable(cur_i);
    if (n < 0) { return 0; }
    if (proc_ksp[n] == 0) { return 0; }
    // El otro agotó su cuota y yo no: sigo yo. Si es al revés, me saco.
    if (zcpu_throttled(proc_zone[n]) != 0 && zcpu_throttled(proc_zone[cur_i]) == 0) { return 0; }
    proc_ksp[cur_i] = saved_ksp;
    switch_to(n);
    nswitch_timer = nswitch_timer + 1;
    return 1;
}

fn read_user_ctx() -> i64 {
    let p = __syscall_rsp;
    uctx_rsp = *(p - 8);
    uctx_rip = *(p - 16);
    uctx_rfl = *(p - 24);
    return 0;
}

// rbp del usuario: el prólogo de la syscall lo empuja justo después de
// rsp, rcx y r11 (32 bytes bajo la pila de syscall).
fn user_rbp() -> i64 {
    let p = __syscall_rsp;
    return *(p - 32);
}

fn yield_current() -> i64 {
    let n = other_runnable(cur_i);
    if (n < 0 || proc_ksp[n] == 0) { return 0; }
    // No se cede a una zona con la cuota agotada si la mía no la agotó.
    if (zcpu_throttled(proc_zone[n]) != 0 && zcpu_throttled(proc_zone[cur_i]) == 0) { return 0; }
    read_user_ctx();
    uctx_rfl = uctx_rfl | 0x202;
    let urbp = user_rbp();
    forge(cur_i, uctx_rip, uctx_rsp, uctx_rfl);
    // forge deja todos los GPR en 0; rbp es el marco de la función de
    // usuario (el código de Copihue lo usa), así que se conserva.
    let fr: *u64 = proc_ksp[cur_i] as *u64;
    fr[10] = urbp;
    switch_to(n);
    nswitch_yield = nswitch_yield + 1;
    resume_frame();
    return 0;
}

fn release_proc(pi: i64) -> i64 {
    uline_flush(pi);
    proc_lbuf[pi] = 0;
    let z = proc_zone[pi];
    charge_zone = z;
    let n = proc_npages[pi];
    let f = 0;
    let i = 0;
    while (i < n) {
        let pa = proc_pages[pi * 32 + i];
        if (free_page(pa) != 0 && page_is_free(pa) != 0) {
            f = f + 1;
            released_ok = released_ok + 1;
        }
        i = i + 1;
    }
    charge_zone = 0;
    proc_npages[pi] = 0;
    proc_freed[pi] = f;
    proc_state[pi] = 0;
    if (proc_held[pi] != 0) {
        zone_release(z);
        proc_held[pi] = 0;
    }
    proc_zone[pi] = 0;
    proc_uva[pi] = 0;
    proc_io[pi] = 0;
    proc_ihi[pi] = 0;
    proc_wlo[pi] = 0;
    udp_release(pi);
    tcp_release(pi);
    return f;
}

fn exit_log(me: i64) -> i64 {
    putc('\n');
    puts("exit pid=");
    put_int(proc_pid[me]);
    puts(" freed=");
    put_int(proc_freed[me]);
    puts("\n");
    return 0;
}

fn exit_current() -> i64 {
    let me = cur_i;
    proc_state[me] = 3;
    let n = other_alive(me);
    if (n >= 0 && proc_ksp[n] != 0) {
        // Salir con el otro vivo también cambia la zona activa; no hay
        // `switch` (la sonda 2 es de switch_to), solo zone-switch.
        zone_note_switch(proc_pid[me], proc_zone[me], proc_zone[n]);
        proc_state[n] = 2;
        cur_i = n;
        tss.rsp0 = proc_rsp0[n];
        set_syscall_stack(proc_sys[n]);
        write_cr3(proc_pml4[n]);
        saved_ksp = proc_ksp[n];
        release_proc(me);
        exit_log(me);
        resume_frame();
    } else {
        write_cr3(0x1000);
        release_proc(me);
        exit_log(me);
        sched_on = 0;
        tss.rsp0 = 0x86000;
        set_syscall_stack(0x81000);
        resume_shell();
    }
    return 0;
}

// Hay un punto de recuperación para el próximo fallo de este proceso?
// Solo la prueba `sched` los arma (proc_rec0/1). Un proceso de `exec` o de
// zona no tiene: antes caía en `pf-cross norec` y el kernel entero se
// detenía con hlt. Ahora se le mata a él solo (SG-01 parte 2).
fn user_fault_rec() -> i64 {
    if (proc_faults[cur_i] == 0) { return proc_rec0[cur_i]; }
    return proc_rec1[cur_i];
}

// Mata al proceso en curso por un fallo de anillo 3: lo da de baja como
// exit (devuelve sus páginas y su cupo de zona) y sigue con el otro
// proceso o vuelve al shell. addr es CR2 en un #PF y RIP en un #GP.
fn user_kill(vec: i64, err: i64, addr: i64) -> i64 {
    uline_flush(cur_i);
    putc('\n');
    puts("user killed pid=");
    put_int(proc_pid[cur_i]);
    puts(" vec=");
    put_int(vec);
    puts(" err=");
    put_hex(err);
    puts(" addr=");
    put_hex64(addr);
    puts("\n");
    user_kills = user_kills + 1;
    return exit_current();
}

fn note_user_fault(err: i64) -> i64 {
    let addr = read_cr2();
    uline_flush(cur_i);
    if (proc_faults[cur_i] == 0) { patch_rip = proc_rec0[cur_i]; }
    else { patch_rip = proc_rec1[cur_i]; }
    proc_faults[cur_i] = proc_faults[cur_i] + 1;
    putc('\n');
    puts("pf-cross ");
    if ((err & 2) != 0) { puts("W"); } else { puts("R"); }
    puts(" pid=");
    put_int(proc_pid[cur_i]);
    puts(" cr2=");
    put_hex(addr);
    puts(" err=");
    put_hex(err);
    puts("\n");
    if (patch_rip == 0) {
        puts("pf-cross norec\n");
        while (1) { hlt(); }
    }
    return 0;
}

naked fn resume_frame() {
    rbp = saved_ksp;
    rsp = rbp;
    pop(r15);
    pop(r14);
    pop(r13);
    pop(r12);
    pop(r11);
    pop(r10);
    pop(r9);
    pop(r8);
    pop(rdi);
    pop(rsi);
    pop(rbp);
    pop(rbx);
    pop(rdx);
    pop(rcx);
    pop(rax);
    iretq();
}

fn alias_capture() -> i64 {
    let p: *u8 = (kimg_va()) as *u8;
    alias_b0 = p[0];
    alias_b1 = p[1];
    alias_b7 = p[7];
    return 1;
}

fn alias_at(off: i64) -> i64 {
    alias_ptr = kimg_va() + off;
    let p: *u8 = alias_ptr as *u8;
    alias_byte = p[0];
    return alias_byte;
}

fn alias_ok() -> i64 {
    if (alias_at(0) != alias_b0) { return 0; }
    if (alias_at(1) != alias_b1) { return 0; }
    if (alias_at(7) != alias_b7) { return 0; }
    return 1;
}

fn alias_both() -> i64 {
    if (alias_capture() == 0) { puts("alias fail\n"); return 0; }
    write_cr3(proc_pml4[0]);
    puts("cr3 a=");
    put_hex(read_cr3());
    puts("\n");
    if (alias_ok() == 0) { puts("alias fail\n"); return 0; }
    puts("alias ok\n");
    write_cr3(proc_pml4[1]);
    puts("cr3 b=");
    put_hex(read_cr3());
    puts("\n");
    if (alias_ok() == 0) { puts("alias fail\n"); return 0; }
    puts("alias ok\n");
    write_cr3(0x1000);
    return 1;
}

fn paint_secret(pa: i64) -> i64 {
    if (map_page(0x300000, pa, 3 | pte_nx_bit()) == 0) { return 0; }
    let created = last_alloc_pt;
    let b: *u8 = 0x300000;
    b[0] = 0xA5;
    unmap_page(0x300000);
    if (created != 0) {
        let root = cr3_root();
        let pml4: *u64 = root as *u64;
        let e = pml4[(0x300000 >> 39) & 511];
        let pdpt: *u64 = ((e >> 12) << 12) as *u64;
        e = pdpt[(0x300000 >> 30) & 511];
        let pd: *u64 = ((e >> 12) << 12) as *u64;
        pd[(0x300000 >> 21) & 511] = 0;
        invlpg(0x300000);
        free_page(created);
    }
    return 1;
}

fn copy_user(pi: i64, src: i64, n: i64, code: i64) -> i64 {
    if (n <= 0 || n > 4096) { return 0; }
    write_cr3(proc_pml4[pi]);
    zero_va(0x400000);
    zero_va(0x401000);
    let dst: *u8 = 0x400000;
    let s: *u8 = src as *u8;
    let i = 0;
    while (i < n) {
        dst[i] = s[i];
        i = i + 1;
    }
    write_cr3(0x1000);
    if (map_in(proc_pml4[pi], 0x400000, code, 5) == 0) { return 0; }
    return 1;
}

// Distribución de memoria de un proceso (EX-01, docs/exec.md).
//
// Legado (AXE1, build_proc y las demos): una página de código en 0x400000,
// una página de pila y E/S en 0x401000 (pila hasta 0x402000), páginas pedidas
// con la syscall 8 desde 0x402000. proc_io, proc_ihi y proc_wlo valen 0.
//
// AXE2 (build_image): imagen de 1 a 16 páginas desde 0x400000, la página de
// E/S sola en 0x410000, una página de guarda sin mapa en 0x411000, la pila en
// 0x412000 (tope 0x413000) y las páginas de la syscall 8 desde 0x413000. La
// pila crece hacia abajo: un desborde cae en la guarda y mata solo a ese
// proceso, en vez de pisar la página de E/S. Las páginas de texto de la imagen son de solo
// lectura y ejecutables; el resto de la imagen (datos y bss) es de lectura y
// escritura sin ejecución.
//   proc_io[pi]   base de la página de E/S (+0x800 nombre, +0xC00 datos)
//   proc_ihi[pi]  fin de la imagen, exclusivo
//   proc_wlo[pi]  desde dónde la imagen se puede escribir
let proc_io: [i64; 2];
let proc_ihi: [i64; 2];
let proc_wlo: [i64; 2];
let proc_img: [i64; 32];

// Base de la página de E/S del proceso en curso: ahí el kernel lee el nombre
// (zone_read_name) y los datos (zone_read_data) de las syscalls 6, 7 y 27.
fn uio_base() -> i64 {
    let pi = cur_i;
    if (pi >= 0 && pi < 2 && proc_io[pi] != 0) { return proc_io[pi]; }
    return 0x401000;
}

// Lo común de build_proc y build_image: pid, pilas del kernel, zona, y las
// tres tablas (PML4, PDPT, PD) con la mitad del kernel. 1 si salió bien. Deja
// charge_zone en la zona; el que sigue lo pone en 0 al terminar o fallar.
fn proc_begin(pi: i64) -> i64 {
    if (pi == 0) {
        proc_pid[0] = 1;
        proc_rsp0[0] = 0x60000;
        proc_sys[0] = 0x70000;
    } else {
        proc_pid[1] = 2;
        proc_rsp0[1] = 0x68000;
        proc_sys[1] = 0x78000;
    }
    proc_uva[pi] = 0;
    proc_held[pi] = 0;
    uline_n[pi] = 0;
    proc_lbuf[pi] = 0;
    proc_io[pi] = 0;
    proc_ihi[pi] = 0;
    proc_wlo[pi] = 0;
    udp_release(pi);
    tcp_release(pi);
    proc_zone[pi] = build_zone;
    if (zone_acquire(build_zone) != 0) { return 0; }
    proc_held[pi] = 1;
    charge_zone = build_zone;
    let pml4 = take_table(pi);
    let pdpt = take_table(pi);
    let pd = take_table(pi);
    if (pml4 == 0 || pdpt == 0 || pd == 0) {
        charge_zone = 0;
        zone_errno = 6;
        return 0;
    }
    let p4: *u64 = pml4 as *u64;
    let p3: *u64 = pdpt as *u64;
    let p2: *u64 = pd as *u64;
    p4[0] = pdpt | 7;
    p3[0] = pd | 7;
    p2[0] = low_pd_entry();
    proc_pml4[pi] = pml4;
    attach_half(pml4);
    return 1;
}

fn build_fail() -> i64 {
    charge_zone = 0;
    zone_errno = 6;
    return 0;
}

// Una página de código y una de pila: la distribución de legado.
fn build_proc(pi: i64, src: i64, n: i64, secret: i64) -> i64 {
    if (proc_begin(pi) == 0) { return 0; }
    let code = take_page(pi, 0);
    let stack = take_page(pi, 0);
    if (code == 0 || stack == 0) {
        charge_zone = 0;
        zone_errno = 6;
        return 0;
    }
    if (map_user(pi, 0x400000, code, 7 | pte_nx_bit()) == 0) {
        charge_zone = 0;
        zone_errno = 6;
        return 0;
    }
    if (map_user(pi, 0x401000, stack, 7 | pte_nx_bit()) == 0) {
        charge_zone = 0;
        zone_errno = 6;
        return 0;
    }
    if (secret != 0) {
        let data = take_page(pi, 0);
        if (data == 0) {
            charge_zone = 0;
            zone_errno = 6;
            return 0;
        }
        if (paint_secret(data) == 0) {
            charge_zone = 0;
            zone_errno = 6;
            return 0;
        }
        if (map_user(pi, 0x500000, data, 7 | pte_nx_bit()) == 0) {
            charge_zone = 0;
            zone_errno = 6;
            return 0;
        }
    }
    if (copy_user(pi, src, n, code) == 0) {
        charge_zone = 0;
        zone_errno = 6;
        return 0;
    }
    forge(pi, 0x400000, 0x402000, 0x202);
    proc_state[pi] = 1;
    charge_zone = 0;
    return 1;
}

// Un proceso con imagen de varias páginas (AXE2). src son los n bytes de la
// imagen; text_n los del texto (desde el principio) y mem_n el tamaño en
// memoria (lo que pasa de n queda en cero: bss). 1 a 16 páginas; las de texto
// quedan de solo lectura y ejecutables, las demás de lectura y escritura sin
// ejecución. La E/S y la pila van aparte (ver proc_io arriba). Deja un marco
// con entrada 0x400000; el que llama hace forge con la entrada del archivo.
fn build_image(pi: i64, src: i64, n: i64, text_n: i64, mem_n: i64) -> i64 {
    let npg = (mem_n + 4095) >> 12;
    let tpg = (text_n + 4095) >> 12;
    if (npg < 1 || npg > 16 || tpg < 1 || tpg > npg || n < 1 || n > mem_n) {
        zone_errno = 9;
        return 0;
    }
    if (proc_begin(pi) == 0) { return 0; }
    let i = 0;
    while (i < npg) {
        let pg = take_page(pi, 0);
        if (pg == 0) { return build_fail(); }
        proc_img[pi * 16 + i] = pg;
        if (map_user(pi, 0x400000 + i * 4096, pg, 7 | pte_nx_bit()) == 0) { return build_fail(); }
        i = i + 1;
    }
    let io = take_page(pi, 0);
    let stack = take_page(pi, 0);
    if (io == 0 || stack == 0) { return build_fail(); }
    if (map_user(pi, 0x410000, io, 7 | pte_nx_bit()) == 0) { return build_fail(); }
    if (map_user(pi, 0x412000, stack, 7 | pte_nx_bit()) == 0) { return build_fail(); }
    // El kernel escribe por las tablas del propio proceso, mientras todas
    // las páginas son de escritura (como copy_user).
    write_cr3(proc_pml4[pi]);
    i = 0;
    while (i < npg) {
        zero_va(0x400000 + i * 4096);
        i = i + 1;
    }
    zero_va(0x410000);
    zero_va(0x412000);
    let dst: *u8 = 0x400000;
    let s: *u8 = src as *u8;
    i = 0;
    while (i < n) {
        dst[i] = s[i];
        i = i + 1;
    }
    write_cr3(0x1000);
    i = 0;
    while (i < tpg) {
        if (map_in(proc_pml4[pi], 0x400000 + i * 4096, proc_img[pi * 16 + i], 5) == 0) { return build_fail(); }
        i = i + 1;
    }
    proc_io[pi] = 0x410000;
    proc_ihi[pi] = 0x400000 + npg * 4096;
    proc_wlo[pi] = 0x400000 + tpg * 4096;
    proc_uva[pi] = 0x413000;
    forge(pi, 0x400000, 0x413000, 0x202);
    proc_state[pi] = 1;
    charge_zone = 0;
    return 1;
}

fn dump_tables() -> i64 {
    puts("pml4 a=");
    put_hex(proc_pml4[0]);
    puts(" b=");
    put_hex(proc_pml4[1]);
    puts("\n");
    puts("half a=");
    put_hex(pml4_slot(0, 256));
    puts(" b=");
    put_hex(pml4_slot(1, 256));
    puts("\n");
    puts("span a=");
    put_hex(pml4_slot(0, 511));
    puts(" b=");
    put_hex(pml4_slot(1, 511));
    puts("\n");
    puts("low a=");
    put_hex(pml4_slot(0, 0));
    puts(" b=");
    put_hex(pml4_slot(1, 0));
    puts("\n");
    puts("rec r=");
    put_hex(proc_rec0[1]);
    puts(" w=");
    put_hex(proc_rec1[1]);
    puts("\n");
    return 0;
}

fn sched_go() -> i64 {
    let iflags: u64 = irq_save();
    // save_context devuelve 0. Se pisa rip con la etiqueta: resume_shell
    // vuelve ahí, con este marco, y save_context no devuelve 1.
    if (save_context(&shell_ctx) == 0) {
        shell_ctx.rip = label_addr(after_sched);
        cur_i = 0;
        proc_state[0] = 2;
        tss.rsp0 = proc_rsp0[0];
        set_syscall_stack(proc_sys[0]);
        write_cr3(proc_pml4[0]);
        saved_ksp = proc_ksp[0];
        puts("run begin\n");
        sched_on = 1;
        resume_frame();
    }
    label after_sched;
    shell_ctx.rip = 0;
    sched_on = 0;
    write_cr3(0x1000);
    tss.rsp0 = 0x86000;
    set_syscall_stack(0x81000);
    irq_restore(iflags);
    putc('\n');
    puts("run end\n");
    return 0;
}

fn sched_summary() -> i64 {
    puts("switch timer=");
    put_int(nswitch_timer);
    puts(" yield=");
    put_int(nswitch_yield);
    puts("\n");
    puts("sched base=");
    put_int(sched_base);
    puts(" back=");
    put_int(pmm_free);
    puts("\n");
    puts("sched released=");
    put_int(released_ok);
    puts("\n");
    if (page_is_free(shared_pdpt) == 0 && page_is_free(shared_pd) == 0) {
        puts("half kept\n");
    }
    if (page_is_free(proc_pml4[0]) != 0 && page_is_free(proc_pml4[1]) != 0) {
        puts("pml4 free\n");
    }
    puts("sched ok\n");
    return 0;
}

// Process A. Reads its private page, prints, yields, then spins in ring 3
// so the PIT can preempt it. Copied to 0x400000; the trailing ret the
// compiler adds is not executed. No naked local: that slot lives in the
// kernel image and ring 3 cannot read it. The round counter is rbp.
// while uses rbx as scratch, and forge() resumes a yield with every GPR
// cleared, so rbp is set after the yields. syscall's leave restores rbp.
naked fn prog_a() {
    al = *(0x500000 as *u8);
    if (al == 0xA5) {
        rax = 1;
        rdi = 77;
        syscall();
        rax = 1;
        rdi = 10;
        syscall();
    }
    rax = 1;
    rdi = 65;
    syscall();
    rax = 1;
    rdi = 10;
    syscall();
    rax = 3;
    syscall();
    rdi = rax + 48;
    rax = 1;
    syscall();
    rax = 1;
    rdi = 10;
    syscall();
    rax = 4;
    syscall();
    rax = 1;
    rdi = 65;
    syscall();
    rax = 1;
    rdi = 10;
    syscall();
    rax = 4;
    syscall();
    rbp = 6;
    while (rbp != 0) {
        ecx = 4000000;
        while (ecx != 0) { ecx = ecx - 1; }
        rax = 1;
        rdi = 97;
        syscall();
        rbp = rbp - 1;
    }
    rax = 5;
    syscall();
    hlt();
}

naked fn prog_a_end() {
    hlt();
}

// Process B. The read and the write of 0x500000 are the last instruction
// of their own naked functions; #PF resumes at the next one.
naked fn prog_b() {
    rax = 1;
    rdi = 66;
    syscall();
    rax = 1;
    rdi = 10;
    syscall();
    rax = 3;
    syscall();
    rdi = rax + 48;
    rax = 1;
    syscall();
    rax = 1;
    rdi = 10;
    syscall();
    al = *(0x500000 as *u8);
}

naked fn prog_b_ar() {
    *(0x500000 as *u8) = 90;
}

naked fn prog_b_aw() {
    rax = 1;
    rdi = 66;
    syscall();
    rax = 4;
    syscall();
    rax = 1;
    rdi = 66;
    syscall();
    rax = 4;
    syscall();
    rbp = 6;
    while (rbp != 0) {
        ecx = 4000000;
        while (ecx != 0) { ecx = ecx - 1; }
        rax = 1;
        rdi = 98;
        syscall();
        rbp = rbp - 1;
    }
    rax = 5;
    syscall();
    hlt();
}

naked fn prog_b_end() {
    hlt();
}

fn sched_demo() -> i64 {
    let iflags: u64 = irq_save();
    // `nx` también libera procesos. Esta línea es la de esta corrida.
    released_ok = 0;
    build_zone = 0;
    charge_zone = 0;
    if (shared_init() == 0) {
        irq_restore(iflags);
        puts("sched fail\n");
        return 0;
    }
    sched_base = pmm_free;
    let na = &prog_a_end - &prog_a;
    let nb = &prog_b_end - &prog_b;
    if (build_proc(0, &prog_a, na, 1) == 0 || build_proc(1, &prog_b, nb, 0) == 0) {
        write_cr3(0x1000);
        irq_restore(iflags);
        puts("sched fail\n");
        return 0;
    }
    proc_rec0[1] = 0x400000 + (&prog_b_ar - &prog_b);
    proc_rec1[1] = 0x400000 + (&prog_b_aw - &prog_b);
    dump_tables();
    if (alias_both() == 0) {
        write_cr3(0x1000);
        irq_restore(iflags);
        puts("sched fail\n");
        return 0;
    }
    sched_go();
    irq_restore(iflags);
    sched_summary();
    return 0;
}
