// AHCI 1.x (HR-01 lectura, HR-02 escritura). Un puerto SATA, un comando a la
// vez, un sector de 512 B por DMA (READ/WRITE DMA EXT, LBA48; tras escribir,
// FLUSH CACHE EXT). Sin NCQ. Sin interrupciones: se
// sondea PxCI con tope de tiempo del PIT (ata_pit_read, como ata.lap).
// No toca el camino ATA: el arranque y el disco de datos siguen en el IDE.
//
// Se busca en el bus 0 un dispositivo PCI de clase 01:06 (SATA) con
// interfaz 01 (AHCI). Su BAR5 (ABAR) se mueve a AHCI_ABAR, dentro del
// primer GiB que el arranque tiene mapeado (el firmware lo deja arriba de
// 3 GiB). Memoria y bus master se prenden; INTx queda apagado.
//
// Memoria de DMA: una página baja (< 2 MiB, identidad) con
//   +0x000 lista de comandos (1 KiB, una ranura usada)
//   +0x400 FIS recibido (256 B)
//   +0x500 tabla de comando (CFIS + una entrada PRDT en +0x80)
//   +0x800 búfer de datos (512 B)
//
// Códigos (los de ata.lap donde coinciden):
// 0 listo
// 1 se agotó el tiempo
// 2 el disco marcó error (PxTFD.ERR o PxIS.TFES)
// 3 no hay controlador AHCI o ningún puerto con un disco SATA
// 4 LBA fuera de rango
// 5 BAR o memoria de DMA inutilizable

let AHCI_ABAR: i64 = 0x10100000;
// 10 s del PIT (1.193182 MHz). Los discos SATA de QEMU contestan en ms.
let AHCI_PIT_TIMEOUT: i64 = 11931820;
// Cuentas del PIT por milisegundo.
let AHCI_MS: i64 = 1193;

let ahci_dev: i64 = 0;
let ahci_fun: i64 = 0;
let ahci_vid: i64 = 0;
let ahci_did: i64 = 0;
let ahci_mmio: i64 = 0;
let ahci_pi: i64 = 0;
let ahci_port: i64 = 0;
let ahci_pa: i64 = 0;
let ahci_sectors: i64 = 0;
let ahci_ready: i64 = 0;
// Hasta dónde llegó ahci_init (para ahci_dbg): 1 buscar controlador, 2 BAR,
// 3 página de DMA, 4 puerto con disco (FRE, enlace, FIS D2H, firma), 5 limpiar
// SERR/IS, 6 TFD y ST, 7 IDENTIFY. (Hasta HR-03e: 3 puerto, 4 página, 5 parar el puerto.)
let ahci_stage: i64 = 0;
let ahci_buf: [u8; 512];
let ahci_out: [u8; 512];

fn ahci_rd(off: i64) -> i64 {
    let p: *volatile u32 = (ahci_mmio + off) as *volatile u32;
    return p[0] & 0xFFFFFFFF;
}

fn ahci_wr(off: i64, v: i64) -> i64 {
    let p: *volatile u32 = (ahci_mmio + off) as *volatile u32;
    p[0] = v as u32;
    return 0;
}

// Registro del puerto elegido: 0x100 + 0x80 * puerto + reg.
fn ahci_preg(reg: i64) -> i64 {
    return 0x100 + ahci_port * 0x80 + reg;
}

fn ahci_pr(reg: i64) -> i64 { return ahci_rd(ahci_preg(reg)); }
fn ahci_pw(reg: i64, v: i64) -> i64 { return ahci_wr(ahci_preg(reg), v); }

// Dword de la página de DMA: `ahci_m(off)[0] = v` es un store volatile de 32
// bits. Desde Copihue v0.44.4 (EX-09) el store por llamada se emite; antes se
// descartaba sin aviso y esto era una función `ahci_mw(off, v)` con puntero
// local (docs/PEDIDOS_COPIHUE.md, HR-01 punto 1).
fn ahci_m(off: i64) -> *volatile u32 {
    return (ahci_pa + off) as *volatile u32;
}

// Espera hasta `ticks` cuentas del PIT a que (registro & mask) == want. `off`
// es el desplazamiento absoluto dentro del ABAR. 0 listo, 1 tiempo.
fn ahci_spinoff(off: i64, mask: i64, want: i64, ticks: i64) -> i64 {
    let prev = ata_pit_read();
    let acc = 0;
    let n = 0;
    while (acc < ticks) {
        if ((ahci_rd(off) & mask) == want) { return 0; }
        n = n + 1;
        if ((n & 15) == 0) {
            let cur = ata_pit_read();
            let d = prev - cur;
            if (d < 0) { d = d + ATA_PIT_PERIOD; }
            acc = acc + d;
            prev = cur;
        }
    }
    return 1;
}

// Lo mismo sobre un registro del puerto elegido, con el tope largo.
fn ahci_spin(reg: i64, mask: i64, want: i64) -> i64 {
    return ahci_spinoff(ahci_preg(reg), mask, want, AHCI_PIT_TIMEOUT);
}


// Busca el controlador AHCI número `skip` (0 = el primero) en el bus 0. Bajo
// q35 el ICH9 trae uno integrado (casi siempre vacío) y `-device ahci` suma
// otro: ahci_init prueba uno tras otro hasta dar con un disco.
fn ahci_scan(want: i64) -> i64 {
    let skip = want;
    let dev = 0;
    while (dev < 32) {
        let id0 = pci_rd(0, dev, 0, 0);
        if ((id0 & 0xFFFF) != 0xFFFF) {
            let hdr = (pci_rd(0, dev, 0, 0x0C) >> 16) & 255;
            let nfun = 1;
            if ((hdr & 128) != 0) { nfun = 8; }
            let fun = 0;
            while (fun < nfun) {
                let id = pci_rd(0, dev, fun, 0);
                if ((id & 0xFFFF) != 0xFFFF) {
                    // Clase (31:24), subclase (23:16), interfaz (15:8).
                    let cls = pci_rd(0, dev, fun, 8) >> 8;
                    if ((cls & 0xFFFFFF) == 0x010601) {
                        if (skip == 0) {
                            ahci_dev = dev;
                            ahci_fun = fun;
                            ahci_vid = id & 0xFFFF;
                            ahci_did = (id >> 16) & 0xFFFF;
                            return 0;
                        }
                        skip = skip - 1;
                    }
                }
                fun = fun + 1;
            }
        }
        dev = dev + 1;
    }
    return 3;
}

fn ahci_map_bar() -> i64 {
    pci_wr(0, ahci_dev, ahci_fun, 4, 0);
    let bar = pci_rd(0, ahci_dev, ahci_fun, 0x24);
    if ((bar & 1) != 0) { return 5; }
    if ((bar & 6) == 4) { return 5; }
    pci_wr(0, ahci_dev, ahci_fun, 0x24, 0xFFFFFFFF);
    let mask = pci_rd(0, ahci_dev, ahci_fun, 0x24) & 0xFFFFFFF0;
    if (mask == 0) { return 5; }
    let size = ((~mask) + 1) & 0xFFFFFFFF;
    if (size < 0x1000 || size > 0x10000) { return 5; }
    pci_wr(0, ahci_dev, ahci_fun, 0x24, AHCI_ABAR);
    // Memoria + bus master; bit 10 prendido: sin INTx.
    pci_wr(0, ahci_dev, ahci_fun, 4, 0x0406);
    let off = 0;
    while (off < size) {
        if (map_page(AHCI_ABAR + off, AHCI_ABAR + off, 0x1B | pte_nx_bit()) == 0) { return 5; }
        off = off + 4096;
    }
    ahci_mmio = AHCI_ABAR;
    // Si el BAR no quedó donde se pidió, CAP lee todo unos: no es un HBA.
    if (ahci_rd(0x00) == 0xFFFFFFFF) {
        ahci_mmio = 0;
        return 5;
    }
    return 0;
}

// Detiene el motor de comandos y el de FIS recibidos del puerto.
fn ahci_stop() -> i64 {
    let cmd = ahci_pr(0x18);
    if ((cmd & 0x11) != 0 || (cmd & 0xC000) != 0) {
        ahci_pw(0x18, cmd & 0xFFFFFFFE);
        if (ahci_spin(0x18, 0x8000, 0) != 0) { return 1; }
        cmd = ahci_pr(0x18);
        ahci_pw(0x18, cmd & 0xFFFFFFEF);
        if (ahci_spin(0x18, 0x4000, 0) != 0) { return 1; }
    }
    return 0;
}

// COMRESET (PxSCTL.DET = 1 al menos 1 ms, luego 0) y espera de hasta `ticks`
// a que el puerto elegido tenga enlace (DET 3). Con ST en 0. La pausa de 2 ms
// es una espera que no se cumple nunca (CAP & 0 == 1).
fn ahci_comreset(ticks: i64) -> i64 {
    ahci_pw(0x2C, 0x301);
    ahci_spinoff(0x00, 0, 1, AHCI_MS * 2);
    ahci_pw(0x2C, 0x300);
    let r = ahci_spinoff(ahci_preg(0x28), 15, 3, ticks);
    // El reset deja PxSERR.DIAG.X: se limpia para que entren los FIS que siguen.
    ahci_pw(0x30, 0xFFFFFFFF);
    return r;
}

// Deja el puerto elegido sin motor de comandos y con la recepción de FIS
// encendida: lista de comandos y FIS recibido en la página de DMA, SERR e IS
// limpios, PxCMD.FRE (y SUD, POD) y espera a PxCMD.FR. Sin FRE el HBA no
// guarda el FIS D2H que sigue a un reset y PxSIG se queda en 0xFFFFFFFF y
// PxTFD en 0x7F aunque el enlace esté arriba (AHCI 1.3 §10.3.1): el firmware
// de OVMF 2024.02 deja los puertos con PxCMD = 0x6.
fn ahci_port_fre() -> i64 {
    if (ahci_stop() != 0) { return 1; }
    ahci_pw(0x00, ahci_pa);
    ahci_pw(0x04, 0);
    ahci_pw(0x08, ahci_pa + 0x400);
    ahci_pw(0x0C, 0);
    ahci_pw(0x30, 0xFFFFFFFF);
    ahci_pw(0x10, 0xFFFFFFFF);
    ahci_pw(0x14, 0);
    ahci_pw(0x18, ahci_pr(0x18) | 0x16);
    // Un HBA que no refleje FR no debe frenar el arranque: el tope es corto.
    ahci_spinoff(ahci_preg(0x18), 0x4000, 0x4000, 238636);
    return 0;
}

// ¿Tiene el puerto elegido un disco SATA listo (DET 3, IPM 1, firma 0x101)?
// 0 sí; 3 no. Deja el puerto con FRE y sin ST.
fn ahci_probe() -> i64 {
    if (ahci_port_fre() != 0) { return 3; }
    // Sin enlace (DET != 3): COMRESET, ya con FRE, y ~200 ms de espera (lo que
    // paga un puerto vacío).
    if ((ahci_pr(0x28) & 15) != 3 && ahci_comreset(AHCI_MS * 200) != 0) { return 3; }
    // Enlace arriba: esperar BSY y DRQ limpios. Tras un reset PxTFD vale 0x7F
    // (BSY) hasta que llega el D2H, así que esto también espera a ese FIS. Si
    // no llega (el enlace ya estaba arriba sin FRE, o el disco tarda), COMRESET.
    if (ahci_spinoff(ahci_preg(0x20), 0x88, 0, AHCI_MS * 2000) != 0) {
        ahci_comreset(AHCI_MS * 1000);
        if (ahci_spinoff(ahci_preg(0x20), 0x88, 0, AHCI_MS * 4000) != 0) { return 3; }
    }
    let ssts = ahci_pr(0x28);
    if ((ssts & 15) == 3 && ((ssts >> 8) & 15) == 1 && ahci_pr(0x24) == 0x101) { return 0; }
    return 3;
}

// Primer puerto implementado con un disco SATA.
fn ahci_find_port() -> i64 {
    let n = 0;
    while (n < 32) {
        if (((ahci_pi >> n) & 1) != 0) {
            ahci_port = n;
            if (ahci_probe() == 0) { return 0; }
        }
        n = n + 1;
    }
    ahci_port = 0;
    return 3;
}

// Un comando sobre la ranura 0. cmd 0x25 lee un sector con LBA48; 0x35 lo
// escribe (WRITE DMA EXT, desde ahci_buf); 0xEC es IDENTIFY; 0xEA es FLUSH
// CACHE EXT (sin datos, sin PRDT). El resultado de una lectura queda en ahci_buf.
fn ahci_cmd(cmd: i64, lba: i64) -> i64 {
    if (ahci_ready == 0) { return 3; }
    if (ahci_spin(0x20, 0x88, 0) != 0) { return 1; }
    let ct = 0x500;
    let i = 0;
    while (i < 0x40) {
        ahci_m(ct + i * 4)[0] = 0;
        i = i + 1;
    }
    let hdr = 5 | (1 << 16);
    let cnt = 1;
    if (cmd == 0x35) {
        // Escritura: bit W (6) de la cabecera y el sector va al búfer de DMA.
        hdr = hdr | 0x40;
        let q: *u8 = (ahci_pa + 0x800) as *u8;
        let k = 0;
        while (k < 512) {
            q[k] = ahci_buf[k];
            k = k + 1;
        }
    }
    if (cmd == 0xEA) {
        hdr = 5;
        cnt = 0;
    }
    // Cabecera de la ranura 0: CFL 5 dwords, una entrada PRDT (ninguna en FLUSH).
    ahci_m(0)[0] = hdr as u32;
    ahci_m(4)[0] = 0;
    ahci_m(8)[0] = (ahci_pa + ct) as u32;
    ahci_m(12)[0] = 0;
    // FIS H2D: tipo 0x27, bit C, comando, dispositivo LBA, un sector.
    ahci_m(ct)[0] = (0x27 | (0x80 << 8) | (cmd << 16)) as u32;
    ahci_m(ct + 4)[0] = ((lba & 0xFFFFFF) | (0x40 << 24)) as u32;
    ahci_m(ct + 8)[0] = ((lba >> 24) & 0xFFFFFF) as u32;
    ahci_m(ct + 12)[0] = cnt as u32;
    // PRDT: 512 bytes (DBC = 511) al búfer.
    ahci_m(ct + 0x80)[0] = (ahci_pa + 0x800) as u32;
    ahci_m(ct + 0x84)[0] = 0;
    ahci_m(ct + 0x88)[0] = 0;
    ahci_m(ct + 0x8C)[0] = 511;
    ahci_pw(0x10, 0xFFFFFFFF);
    ahci_pw(0x38, 1);
    let prev = ata_pit_read();
    let acc = 0;
    let n = 0;
    while (acc < AHCI_PIT_TIMEOUT) {
        if ((ahci_pr(0x10) & 0x40000000) != 0) { ahci_pw(0x10, 0xFFFFFFFF); return 2; }
        if ((ahci_pr(0x38) & 1) == 0) {
            if ((ahci_pr(0x20) & 1) != 0) { return 2; }
            if (cmd == 0x25 || cmd == 0xEC) {
                let p: *u8 = (ahci_pa + 0x800) as *u8;
                let k = 0;
                while (k < 512) {
                    ahci_buf[k] = p[k];
                    k = k + 1;
                }
            }
            return 0;
        }
        n = n + 1;
        if ((n & 15) == 0) {
            let cur = ata_pit_read();
            let d = prev - cur;
            if (d < 0) { d = d + ATA_PIT_PERIOD; }
            acc = acc + d;
            prev = cur;
        }
    }
    return 1;
}

// Palabra n de ahci_buf tras IDENTIFY.
fn ahci_word(n: i64) -> i64 {
    return (ahci_buf[n * 2] & 255) | ((((ahci_buf[n * 2 + 1] & 255) as i64)) << 8);
}

// Traspaso BIOS/SO (AHCI 1.3 §10.6.3): solo si CAP2.BOH (bit 0). Pide la
// propiedad (BOHC.OOS, bit 1) y espera a que el firmware suelte BOS (bit 0)
// y BB (bit 4). QEMU no lo implementa; un firmware que sí lo hace no debe
// seguir dueño del HBA. Tope 2 s del PIT (BB puede tardar hasta 2 s); si no
// suelta, se sigue igual.
fn ahci_handoff() -> i64 {
    if ((ahci_rd(0x24) & 1) == 0) { return 0; }
    ahci_wr(0x28, ahci_rd(0x28) | 2);
    return ahci_spinoff(0x28, 0x11, 0, AHCI_MS * 2000);
}

// Busca el controlador, arma el puerto y lee IDENTIFY. Idempotente.
fn ahci_init() -> i64 {
    if (ahci_ready != 0) { return 0; }
    let nth = 0;
    let r = 3;
    while (r != 0) {
        ahci_stage = 1;
        r = ahci_scan(nth);
        if (r != 0) { return r; }
        ahci_stage = 2;
        r = ahci_map_bar();
        if (r == 0 && ahci_pa == 0) {
            // La página de DMA se pide antes de buscar el puerto: sondearlo
            // exige FRE y por tanto el FIS recibido en memoria. Una vez.
            ahci_stage = 3;
            let pa = alloc_low_page();
            if (net_pa_ok(pa) == 0) { return 5; }
            zero_va(pa);
            ahci_pa = pa;
        }
        if (r == 0) {
            ahci_stage = 4;
            // GHC.AE (bit 31), IE (bit 1) sigue en 0.
            ahci_wr(0x04, 0x80000000);
            ahci_handoff();
            ahci_pi = ahci_rd(0x0C);
            r = ahci_find_port();
        }
        if (r != 0) {
            // Sin disco aquí: si hay otro controlador, apaga este (memoria y bus
            // master) y prueba el siguiente; si no, lo deja como estaba (ahci_dump).
            let bd = ahci_dev;
            let bf = ahci_fun;
            if (ahci_scan(nth + 1) != 0) {
                ahci_dev = bd;
                ahci_fun = bf;
                return r;
            }
            pci_wr(0, bd, bf, 4, 0);
            nth = nth + 1;
        }
    }
    // ahci_probe dejó el puerto con CLB, FB y FRE puestos (y FR esperado), el
    // D2H recibido y TFD sin BSY/DRQ, y sin ST. Orden de arranque: FRE, FR,
    // TFD, ST.
    ahci_stage = 6;
    if (ahci_spin(0x20, 0x88, 0) != 0) { return 1; }
    ahci_pw(0x18, ahci_pr(0x18) | 0x1);
    ahci_ready = 1;
    ahci_stage = 7;
    r = ahci_cmd(0xEC, 0);
    if (r != 0) { ahci_ready = 0; return r; }
    // Palabras 100..103: sectores LBA48 (aquí bastan las dos bajas).
    ahci_sectors = ahci_word(100) | (ahci_word(101) << 16);
    if (ahci_sectors <= 0) { ahci_ready = 0; return 3; }
    return 0;
}

fn ahci_read(lba: i64, dst: *u8) -> i64 {
    if (lba < 0 || lba >= ahci_sectors) { return 4; }
    let r = ahci_cmd(0x25, lba);
    if (r != 0) { return r; }
    let i = 0;
    while (i < 512) {
        dst[i] = ahci_buf[i];
        i = i + 1;
    }
    return 0;
}

// WRITE DMA EXT de un sector (LBA48) seguido de FLUSH CACHE EXT. Mismos
// códigos que ahci_read; 4 si el LBA cae fuera del disco.
fn ahci_write(lba: i64, src: *u8) -> i64 {
    if (lba < 0 || lba >= ahci_sectors) { return 4; }
    let i = 0;
    while (i < 512) {
        ahci_buf[i] = src[i];
        i = i + 1;
    }
    let r = ahci_cmd(0x35, lba);
    if (r != 0) { return r; }
    return ahci_cmd(0xEA, 0);
}

// " nombre=" y un valor, en hex (kx) o decimal (ki): ahci_dump y ahci_dbg.
fn ahci_kx(s: *u8, v: i64) -> i64 {
    puts(s);
    put_hex(v);
    return 0;
}

fn ahci_ki(s: *u8, v: i64) -> i64 {
    puts(s);
    put_int(v);
    return 0;
}

// Registros del puerto tras un fallo: IS, CMD, TFD, SSTS, SERR, CI.
fn ahci_dump() -> i64 {
    ahci_kx("ahci regs pa=", ahci_pa);
    ahci_kx(" is=", ahci_pr(0x10));
    ahci_kx(" cmd=", ahci_pr(0x18));
    ahci_kx(" tfd=", ahci_pr(0x20));
    ahci_kx(" ssts=", ahci_pr(0x28));
    ahci_kx(" serr=", ahci_pr(0x30));
    ahci_kx(" ci=", ahci_pr(0x38));
    putc('\n');
    return 0;
}

// Diagnóstico tras un ahci_init fallido (código `r`), líneas `ahci dbg ...`
// para grep. Una de resumen (código, etapa de ahci_init, página de DMA,
// páginas libres del pmm) y, por cada controlador AHCI del bus 0, una con
// dispositivo, función, ID, ABAR, CAP, GHC, PI y BOHC, y una por puerto
// implementado con SSTS, SIG, CMD, TFD y SERR. Vuelve a abrir cada BAR para
// leer y lo apaga otra vez; ahci_init lo reconfigura en el próximo intento.
fn ahci_dbg(r: i64) -> i64 {
    ahci_ki("ahci dbg init r=", r);
    ahci_ki(" stage=", ahci_stage);
    ahci_kx(" pa=", ahci_pa);
    ahci_ki(" pmmfree=", pmm_free);
    putc('\n');
    let sd = ahci_dev;
    let sf = ahci_fun;
    let sp = ahci_port;
    let k = 0;
    while (ahci_scan(k) == 0) {
        ahci_ki("ahci dbg ctl=", k);
        ahci_ki(" dev=", ahci_dev);
        ahci_ki(" fun=", ahci_fun);
        ahci_kx(" id=", ahci_vid);
        ahci_kx(":", ahci_did);
        let m = ahci_map_bar();
        ahci_ki(" map=", m);
        if (m == 0) {
            ahci_kx(" abar=", ahci_mmio);
            ahci_kx(" cap=", ahci_rd(0x00));
            ahci_kx(" ghc=", ahci_rd(0x04));
            ahci_kx(" pi=", ahci_rd(0x0C));
            ahci_kx(" bohc=", ahci_rd(0x28));
            putc('\n');
            let pi = ahci_rd(0x0C);
            let n = 0;
            while (n < 32) {
                if (((pi >> n) & 1) != 0) {
                    ahci_port = n;
                    ahci_ki("ahci dbg ctl=", k);
                    ahci_ki(" port=", n);
                    ahci_kx(" ssts=", ahci_pr(0x28));
                    ahci_kx(" sig=", ahci_pr(0x24));
                    ahci_kx(" cmd=", ahci_pr(0x18));
                    ahci_kx(" tfd=", ahci_pr(0x20));
                    ahci_kx(" serr=", ahci_pr(0x30));
                    putc('\n');
                }
                n = n + 1;
            }
            pci_wr(0, ahci_dev, ahci_fun, 4, 0);
        } else {
            putc('\n');
        }
        k = k + 1;
    }
    ahci_ki("ahci dbg ctrls=", k);
    putc('\n');
    ahci_dev = sd;
    ahci_fun = sf;
    ahci_port = sp;
    return 0;
}

let ahci_wsrc: [u8; 512];

// `ahci w <lba> [patrón]`: escribe un sector con byte[i] = (patrón + i) & 255,
// lo vuelve a leer por AHCI y compara byte a byte. Líneas que mira
// tests/qemu_ahci_test.sh: ahci write, ahci verify, ahci write fail.
fn ahci_wdemo(lba: i64, pat: i64) -> i64 {
    let r = ahci_init();
    if (r == 3 && ahci_dev == 0 && ahci_mmio == 0) {
        puts("ahci none\n");
        return 3;
    }
    if (r != 0) {
        if (ahci_mmio != 0) { ahci_dump(); }
        return disk_say("ahci fail", r);
    }
    let i = 0;
    while (i < 512) {
        ahci_wsrc[i] = ((pat + i) & 255) as u8;
        ahci_out[i] = 0;
        i = i + 1;
    }
    r = ahci_write(lba, ahci_wsrc);
    if (r != 0) { return disk_say("ahci write fail", r); }
    puts("ahci write lba=");
    put_int(lba);
    puts(" crc=");
    put_hex(crc32(ahci_wsrc, 512));
    putc('\n');
    r = ahci_read(lba, ahci_out);
    if (r != 0) { return disk_say("ahci read fail", r); }
    let bad = 0;
    i = 0;
    while (i < 512) {
        if (ahci_out[i] != ahci_wsrc[i]) { bad = bad + 1; }
        i = i + 1;
    }
    puts("ahci verify lba=");
    put_int(lba);
    puts(" crc=");
    put_hex(crc32(ahci_out, 512));
    if (bad == 0) {
        puts(" ok\n");
        return 0;
    }
    puts(" mismatch bytes=");
    put_int(bad);
    putc('\n');
    return 6;
}

// `ahci [lba]`: detecta, imprime el controlador y el disco, lee el sector
// (0 por omisión) y da su CRC-32 y los dos últimos bytes. Las líneas que
// mira tests/qemu_ahci_test.sh: ahci none, ahci found, ahci disk, ahci read.
fn ahci_demo(lba: i64) -> i64 {
    let r = ahci_init();
    if (r == 3 && ahci_dev == 0 && ahci_mmio == 0) {
        puts("ahci none\n");
        return 3;
    }
    if (r != 0) {
        if (ahci_mmio != 0) { ahci_dump(); }
        return disk_say("ahci fail", r);
    }
    puts("ahci found ");
    put_hex(ahci_vid);
    putc(':');
    put_hex(ahci_did);
    puts(" abar=");
    put_hex(ahci_mmio);
    puts(" pi=");
    put_hex(ahci_pi);
    putc('\n');
    puts("ahci disk port=");
    put_int(ahci_port);
    puts(" sectors=");
    put_int(ahci_sectors);
    putc('\n');
    r = ahci_read(lba, ahci_out);
    if (r != 0) { return disk_say("ahci read fail", r); }
    puts("ahci read lba=");
    put_int(lba);
    puts(" crc=");
    put_hex(crc32(ahci_out, 512));
    puts(" tail=");
    put_hex(((((ahci_out[510] & 255) as i64)) << 8) | (ahci_out[511] & 255));
    putc('\n');
    return 0;
}
