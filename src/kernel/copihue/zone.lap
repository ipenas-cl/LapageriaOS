// Zonas ligeras. La zona 0 es la global (shell y kernel). Una zona
// nueva niega toda syscall que no esté en su máscara, ve el sistema de
// archivos solo desde su raíz (/zonas/<nombre>, que `zone create` crea) y
// no pasa de su tope de páginas ni de procesos. El kernel antepone la
// raíz: el programa manda un nombre relativo. Un ".." o una ruta
// absoluta se niegan con -1 y suben `niega`. docs/zonas.md.
//
// El nombre es de 16 bytes por zona. ZoneStr lo mide; zone_layout lo
// chequea. El programa deja el nombre en la página de E/S + 0x800 y los
// datos en + 0xC00 (uio_base, sched.lap): 0x401800 y 0x401C00 en un AXE1,
// 0x410800 y 0x410C00 en un AXE2.

packed struct ZoneStr {
    b: [u8; 16]
}

let zone_live: [i64; 8];
let zone_cap: [i64; 8];
let zone_pages: [i64; 8];
let zone_hi: [i64; 8];
let zone_mask: [i64; 8];
let zone_nproc: [i64; 8];
let zone_maxproc: [i64; 8];
let zone_niega: [i64; 8];
let zone_fuga: [i64; 8];
let zone_name: [ZoneStr; 8];
let zone_raw: [u8; 16];
let zone_path: [u8; 64];
let zone_io: [u8; 64];
let zone_errno: i64 = 0;
let build_zone: i64 = 0;

fn zone_fail(n: i64) -> i64 {
    puts("zone fail ");
    put_int(n);
    putc('\n');
    return 0;
}

fn zone_user_mask() -> i64 {
    let m = 0;
    m = m | (1 << 1);
    m = m | (1 << 5);
    m = m | (1 << 6);
    m = m | (1 << 7);
    m = m | (1 << 8);
    return m;
}

fn zone_set_name(z: i64, s: *u8) -> i64 {
    let i = 0;
    while (i < 16) {
        zone_name[z].b[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 15) {
        let c = s[i] & 255;
        if (c == 0) { return 1; }
        zone_name[z].b[i] = c;
        i = i + 1;
    }
    return 0;
}

fn zone_eq_name(z: i64, s: *u8) -> i64 {
    let i = 0;
    while (i < 16) {
        let a = zone_name[z].b[i] & 255;
        let b = s[i] & 255;
        if (a != b) { return 0; }
        if (a == 0) { return 1; }
        i = i + 1;
    }
    return 1;
}

fn zone_by_name(s: *u8) -> i64 {
    let i = 0;
    while (i < 8) {
        if (zone_live[i] != 0 && zone_eq_name(i, s) != 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn zone_ident_ok(s: *u8) -> i64 {
    let i = 0;
    while (i < 8) {
        let c = s[i] & 255;
        if (c == 0) {
            if (i == 0) { return 0; }
            return 1;
        }
        let ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    if ((s[8] & 255) != 0) { return 0; }
    return 1;
}

fn zone_layout() -> i64 {
    if (sizeof(ZoneStr) != 16) { return 0; }
    if (offsetof(ZoneStr, b) != 0) { return 0; }
    return 1;
}

fn zone_init() -> i64 {
    if (zone_layout() == 0) {
        puts("zone layout\n");
        return 0;
    }
    zone_live[0] = 1;
    zone_cap[0] = 32768;
    zone_mask[0] = 0 - 1;
    zone_maxproc[0] = 8;
    zone_pages[0] = 0;
    zone_hi[0] = 0;
    zone_nproc[0] = 0;
    zone_niega[0] = 0;
    zone_fuga[0] = 0;
    zone_set_name(0, "global");
    return 0;
}

fn zone_for_new(parent: i64) -> i64 {
    if (parent < 0) { return 0; }
    if (parent > 1) { return 0; }
    return proc_zone[parent];
}

fn zone_shell() -> i64 {
    if (sched_on != 0) { return 0; }
    return 1;
}

fn zone_acquire(z: i64) -> i64 {
    if (z < 0 || z >= 8) {
        zone_errno = 11;
        return 0 - 1;
    }
    if (z > 0 && zone_live[z] == 0) {
        zone_errno = 11;
        return 0 - 1;
    }
    if (zone_maxproc[z] <= 0 || zone_nproc[z] >= zone_maxproc[z]) {
        zone_errno = 4;
        return 0 - 1;
    }
    zone_nproc[z] = zone_nproc[z] + 1;
    return 0;
}

fn zone_release(z: i64) -> i64 {
    if (z < 0 || z >= 8) { return 0; }
    if (zone_nproc[z] > 0) { zone_nproc[z] = zone_nproc[z] - 1; }
    return zone_nproc[z];
}

fn zone_room(z: i64) -> i64 {
    if (z <= 0) { return 1; }
    if (z >= 8) { return 0; }
    if (zone_live[z] == 0) { return 0; }
    if (zone_pages[z] >= zone_cap[z]) { return 0; }
    return 1;
}

fn zone_account_alloc(z: i64) -> i64 {
    if (z <= 0 || z >= 8) { return 0; }
    zone_pages[z] = zone_pages[z] + 1;
    if (zone_pages[z] > zone_hi[z]) { zone_hi[z] = zone_pages[z]; }
    return zone_pages[z];
}

fn zone_account_free(z: i64) -> i64 {
    if (z <= 0 || z >= 8) { return 0; }
    if (zone_pages[z] > 0) { zone_pages[z] = zone_pages[z] - 1; }
    return zone_pages[z];
}

fn zone_gate(nr: i64) -> i64 {
    if (sched_on == 0) { return 0; }
    let z = proc_zone[cur_i];
    if (z <= 0) { return 0; }
    // Sonda 19: a = número de syscall, b = motivo (1 máscara, 2 escape de zona).
    if (nr == 9) {
        zone_fuga[z] = zone_fuga[z] + 1;
        if (tr_en[19] != 0) { trace_hit(19, proc_pid[cur_i], nr, 2); }
        return 0 - 2;
    }
    if (nr <= 0 || nr >= 62) {
        zone_niega[z] = zone_niega[z] + 1;
        if (tr_en[19] != 0) { trace_hit(19, proc_pid[cur_i], nr, 1); }
        return 0 - 1;
    }
    let bit = 1 << nr;
    if ((zone_mask[z] & bit) == 0) {
        zone_niega[z] = zone_niega[z] + 1;
        if (tr_en[19] != 0) { trace_hit(19, proc_pid[cur_i], nr, 1); }
        return 0 - 1;
    }
    return 0;
}

fn zone_read_name() -> i64 {
    let u: *ZoneStr = (uio_base() + 0x800) as *ZoneStr;
    let i = 0;
    let saw = 0;
    while (i < 16) {
        let c = u.b[i] & 255;
        zone_raw[i] = c as u8;
        if (c == 0) { saw = 1; }
        i = i + 1;
    }
    if (saw == 0) { return 0 - 12; }
    return 0;
}

// Raíz de la zona: el directorio /zonas/<nombre>. El programa manda un
// nombre relativo a esa raíz y el kernel arma la ruta completa en
// zone_path. La zona global no tiene raíz propia: ve todo el árbol.
fn zone_root_path(z: i64) -> i64 {
    let i = 0;
    let pre: *u8 = "/zonas/";
    while (i < 7) {
        zone_path[i] = pre[i];
        i = i + 1;
    }
    let j = 0;
    while (j < 8) {
        let c = zone_name[z].b[j] & 255;
        if (c == 0) { j = 8; }
        else {
            zone_path[i] = c as u8;
            i = i + 1;
            j = j + 1;
        }
    }
    zone_path[i] = 0;
    return i;
}

// Un nombre de zona es válido si son componentes de 1 a 15 bytes
// imprimibles, separados por una sola '/', sin "." ni "..", sin '/' al
// principio (ruta absoluta) ni al final. Todo lo demás se niega.
fn zone_rel_ok() -> i64 {
    let i = 0;
    let n = 0;
    while (i < 16) {
        let c = zone_raw[i] & 255;
        if (c == 0 || c == 47) {
            if (n == 0) { return 0; }
            if (n == 1 && (zone_raw[i - 1] & 255) == 46) { return 0; }
            if (n == 2 && (zone_raw[i - 1] & 255) == 46 && (zone_raw[i - 2] & 255) == 46) { return 0; }
            if (c == 0) { return 1; }
            n = 0;
        } else {
            if (c < 33 || c > 126) { return 0; }
            n = n + 1;
        }
        i = i + 1;
    }
    return 0;
}

// Una negación de ruta cuenta en `niega`, deja la sonda 19 con b = 3 y
// devuelve -1, igual que una syscall fuera de la máscara.
fn zone_path_denied(z: i64) -> i64 {
    if (z > 0 && z < 8) { zone_niega[z] = zone_niega[z] + 1; }
    if (tr_en[19] != 0) { trace_hit(19, proc_pid[cur_i], 3, 0); }
    return 0 - 1;
}

// Deja en zone_path la ruta del archivo que pide la zona z. 0, o -1 si se
// niega. La zona 0 pasa el nombre tal cual.
fn zone_resolve(z: i64) -> i64 {
    let i = 0;
    if (z <= 0) {
        while (i < 16) {
            zone_path[i] = zone_raw[i];
            i = i + 1;
        }
        zone_path[16] = 0;
        return 0;
    }
    if (zone_rel_ok() == 0) { return zone_path_denied(z); }
    let n = zone_root_path(z);
    zone_path[n] = 47;
    n = n + 1;
    i = 0;
    while (i < 16) {
        let c = zone_raw[i] & 255;
        zone_path[n + i] = c as u8;
        if (c == 0) { return 0; }
        i = i + 1;
    }
    return zone_path_denied(z);
}

fn zone_read_data(n: i64) -> i64 {
    if (n < 0 || n > 64) { return 0 - 9; }
    let p: *u8 = (uio_base() + 0xC00) as *u8;
    let i = 0;
    while (i < n) {
        zone_io[i] = p[i];
        i = i + 1;
    }
    return 0;
}

fn zone_write_data(n: i64) -> i64 {
    let p: *u8 = (uio_base() + 0xC00) as *u8;
    let i = 0;
    let m = n;
    if (m > 64) { m = 64; }
    while (i < m) {
        p[i] = zone_io[i];
        i = i + 1;
    }
    return 0;
}

fn zone_sys_write(len: i64) -> i64 {
    if (len < 1 || len > 64) { return 0 - 9; }
    let z = 0;
    if (sched_on != 0) { z = proc_zone[cur_i]; }
    if (zone_read_name() != 0) {
        if (z > 0) { return zone_path_denied(z); }
        return 0 - 12;
    }
    let g = zone_resolve(z);
    if (g != 0) { return g; }
    if (zone_read_data(len) != 0) { return 0 - 9; }
    let r = fs_write(zone_path, zone_io, len);
    if (r != 0) { return 0 - r; }
    return 0;
}

fn zone_sys_read(max: i64) -> i64 {
    let m = max;
    if (m < 0) { return 0 - 9; }
    if (m > 64) { m = 64; }
    let z = 0;
    if (sched_on != 0) { z = proc_zone[cur_i]; }
    if (zone_read_name() != 0) {
        if (z > 0) { return zone_path_denied(z); }
        return 0 - 12;
    }
    let g = zone_resolve(z);
    if (g != 0) { return g; }
    let n = fs_read(zone_path, zone_io, m);
    if (n < 0) { return n; }
    zone_write_data(n);
    return n;
}

fn zone_sys_alloc() -> i64 {
    if (sched_on == 0) { return 0 - 1; }
    let z = proc_zone[cur_i];
    if (z <= 0) { return 0 - 1; }
    if (zone_pages[z] >= zone_cap[z]) { return 0 - 1; }
    let pi = cur_i;
    let va = proc_uva[pi];
    if (va == 0) { va = 0x402000; }
    if (va >= 0x500000) { return 0 - 3; }
    charge_zone = z;
    let pa = alloc_high_page();
    if (pa == 0) {
        charge_zone = 0;
        if (zone_pages[z] >= zone_cap[z]) { return 0 - 1; }
        return 0 - 3;
    }
    if (track(pi, pa) == 0) {
        free_page(pa);
        charge_zone = 0;
        return 0 - 3;
    }
    if (map_user(pi, va, pa, 7 | pte_nx_bit()) == 0) {
        charge_zone = 0;
        return 0 - 3;
    }
    charge_zone = 0;
    proc_uva[pi] = va + 4096;
    return 0;
}

fn zone_sys_set(target: i64) -> i64 {
    if (sched_on == 0) { return 0 - 2; }
    if (proc_zone[cur_i] != 0) { return 0 - 2; }
    if (target < 0 || target >= 8) { return 0 - 11; }
    if (target != 0 && zone_live[target] == 0) { return 0 - 11; }
    let old = proc_zone[cur_i];
    proc_zone[cur_i] = target;
    if (tr_en[18] != 0) { trace_hit(18, proc_pid[cur_i], old, target); }
    return 0;
}

// Libera la ranura de la zona z. 0, 11 si no existe (o es la global) y 16
// si todavía tiene procesos vivos. Los archivos de /zonas/<nombre> quedan
// donde estaban: crear otra zona con ese nombre los vuelve a ver.
fn zone_destroy_z(z: i64) -> i64 {
    if (z <= 0 || z >= 8) { return 11; }
    if (zone_live[z] == 0) { return 11; }
    if (zone_nproc[z] > 0) { return 16; }
    let i = 0;
    while (i < 2) {
        if (proc_state[i] != 0 && proc_zone[i] == z) { return 16; }
        i = i + 1;
    }
    zone_live[z] = 0;
    zone_cap[z] = 0;
    zone_mask[z] = 0;
    zone_pages[z] = 0;
    zone_hi[z] = 0;
    zone_maxproc[z] = 0;
    zone_niega[z] = 0;
    zcpu_reset(z);
    zone_fuga[z] = 0;
    i = 0;
    while (i < 16) {
        zone_name[z].b[i] = 0;
        i = i + 1;
    }
    return 0;
}

// 27 zone_destroy: el nombre de la zona va en la página de E/S + 0x800. Solo un proceso de
// la zona 0 (la máscara de las demás no lleva la 27). 0, -11 si no existe,
// -16 si tiene procesos vivos.
fn zone_sys_destroy() -> i64 {
    if (sched_on == 0) { return 0 - 2; }
    if (proc_zone[cur_i] != 0) { return 0 - 2; }
    if (zone_read_name() != 0) { return 0 - 12; }
    let z = zone_by_name(zone_raw);
    let r = zone_destroy_z(z);
    if (r == 16) { puts("zone busy\n"); }
    if (r != 0) { return 0 - r; }
    puts("zone destroyed ");
    put_int(z);
    putc('\n');
    return 0;
}

fn zone_destroy_cmd(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    let z = zone_by_name(fs_name);
    let r = zone_destroy_z(z);
    if (r == 16) {
        puts("zone busy\n");
        return 0;
    }
    if (r != 0) { return zone_fail(r); }
    puts("zone destroyed ");
    put_int(z);
    putc('\n');
    return 0;
}

fn zone_puts_name(z: i64) -> i64 {
    let i = 0;
    while (i < 16) {
        let c = zone_name[z].b[i] & 255;
        if (c == 0) { return 0; }
        putc(c);
        i = i + 1;
    }
    return 0;
}

fn zone_show(z: i64) -> i64 {
    puts("zone ");
    put_int(z);
    putc(' ');
    zone_puts_name(z);
    puts(" root=");
    if (z == 0) { putc('/'); }
    else {
        zone_root_path(z);
        puts(zone_path);
    }
    puts(" cap=");
    put_int(zone_cap[z]);
    puts(" proc=");
    put_int(zone_nproc[z]);
    putc('/');
    put_int(zone_maxproc[z]);
    puts(" pag=");
    put_int(zone_pages[z]);
    puts(" niega=");
    put_int(zone_niega[z]);
    puts(" fuga=");
    put_int(zone_fuga[z]);
    puts(" max=");
    put_int(zone_hi[z]);
    puts(" cpu=");
    put_int(zcpu_q[z]);
    puts("/20 tot=");
    put_int(zcpu_tot[z]);
    putc('\n');
    return 0;
}

fn zone_ls() -> i64 {
    let i = 0;
    while (i < 8) {
        if (zone_live[i] != 0) { zone_show(i); }
        i = i + 1;
    }
    return 0;
}

// Crea /zonas y /zonas/<nombre> si no están. Un directorio que ya existe
// sirve (una zona destruida deja el suyo). 0 o un código de fs.
fn zone_mkroot(z: i64) -> i64 {
    let r = fs_ensure_dir("/zonas");
    if (r != 0) { return r; }
    zone_root_path(z);
    return fs_ensure_dir(zone_path);
}

// zone create <nombre> <páginas>: la zona queda con raíz /zonas/<nombre>.
fn zone_create(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    if (zone_ident_ok(fs_name) == 0) { return zone_fail(11); }
    if (zone_by_name(fs_name) >= 0) { return zone_fail(11); }
    parse_pos = p;
    let pages = parse_int();
    if (pages < 1 || pages > 4096) { return zone_fail(11); }
    let z = 1;
    let slot = 0 - 1;
    while (z < 8) {
        if (slot < 0 && zone_live[z] == 0) { slot = z; }
        z = z + 1;
    }
    if (slot < 0) { return zone_fail(6); }
    zone_set_name(slot, fs_name);
    let r = zone_mkroot(slot);
    if (r != 0) {
        zone_set_name(slot, "");
        return zone_fail(r);
    }
    zone_live[slot] = 1;
    zone_cap[slot] = pages;
    zone_pages[slot] = 0;
    zone_hi[slot] = 0;
    zone_mask[slot] = zone_user_mask();
    zone_nproc[slot] = 0;
    zone_maxproc[slot] = 2;
    zone_niega[slot] = 0;
    zcpu_reset(slot);
    zone_fuga[slot] = 0;
    puts("zone created ");
    put_int(slot);
    putc('\n');
    return 0;
}

fn zone_plant() -> i64 {
    let n = zone_fill(exec_buf);
    if (n < 16 || n > 4096) { return exec_fail(9); }
    let r = fs_write("ztest", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    puts("zone plant ok\n");
    return 0;
}

// SG-01 parte 2. Escribe `zatk` (el programa de ataque) y `kentry`: un
// AXE1 válido salvo que la cabecera pone la entrada en el texto del kernel.
// `exec kentry` tiene que decir `exec bad entry` y no correr nada.
fn zone_plant_atk() -> i64 {
    let n = atk_fill(exec_buf);
    if (n < 16 || n > 4096) { return exec_fail(9); }
    let r = fs_write("zatk", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    let h: *Axe = axe_of(exec_buf);
    h.entry = (kimg_va()) as u64;
    r = fs_write("kentry", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    puts("zone atk plant ok\n");
    return 0;
}

fn zone_run(z: i64) -> i64 {
    let before = pmm_free;
    puts("zone mem ");
    put_int(before);
    putc('\n');
    let entry = exec_prepare();
    if (entry == 0) { return 0; }
    if (proc_state[0] != 0) { return zone_fail(4); }
    zone_errno = 0;
    let iflags: u64 = irq_save();
    if (shared_init() == 0) {
        irq_restore(iflags);
        return zone_fail(6);
    }
    build_zone = z;
    if (exec_build(0, 0) == 0) {
        write_cr3(0x1000);
        release_proc(0);
        irq_restore(iflags);
        build_zone = 0;
        return zone_fail(zone_errno);
    }
    build_zone = 0;
    puts("zone used ");
    put_int(zone_pages[z]);
    putc('\n');
    sched_go();
    irq_restore(iflags);
    let after = pmm_free;
    puts("zone mem ");
    put_int(after);
    putc('\n');
    if (after != before || zone_pages[z] != 0) {
        puts("zone leak\n");
        return 0;
    }
    puts("zone exec ok\n");
    return 0;
}

fn zone_exec_cmd(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    p = fs_scan(p, fs_name2);
    if (p < 0) { return zone_fail(11); }
    let z = zone_by_name(fs_name);
    if (z < 0) { return zone_fail(11); }
    fs_copy(fs_name, fs_name2, 16);
    return zone_run(z);
}

// `zone net nombre`: agrega las syscalls 12..22 (UDP y TCP) a la máscara de la
// zona. Solo la zona 0 puede pedirlo (cmd_zone). Por defecto una zona
// nueva no tiene red.
fn zone_net(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    let z = zone_by_name(fs_name);
    if (z <= 0) { return zone_fail(11); }
    let nr = 12;
    while (nr <= 22) {
        zone_mask[z] = zone_mask[z] | (1 << nr);
        nr = nr + 1;
    }
    puts("zone net ok\n");
    return 0;
}

// Visibilidad entre procesos (etapa 7). Un proceso de una zona distinta de
// 0 solo ve, y solo puede señalar, a los procesos de su propia zona; la
// zona global ve a todos. Un proceso de otra zona se ve igual que uno que
// no existe (-3): no hay forma de distinguir los dos casos desde la zona.
// El intento deja zone-deny (sonda 19) con b = 4.

// Ranura del proceso vivo con ese pid (listo, corriendo o dormido), o -1.
// pid 0 es el que llama.
fn proc_find(pid: i64) -> i64 {
    if (pid == 0) { return cur_i; }
    let i = 0;
    while (i < 2) {
        let st = proc_state[i];
        if (proc_pid[i] == pid && (st == 1 || st == 2 || st == 4)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Zona del proceso que llama (0 con el planificador apagado).
fn zone_caller() -> i64 {
    if (sched_on == 0) { return 0; }
    return proc_zone[cur_i];
}

// Registra un acceso a otra zona (nr = syscall) y devuelve -1.
fn zone_other_denied(nr: i64) -> i64 {
    if (tr_en[19] != 0) { trace_hit(19, proc_pid[cur_i], nr, 4); }
    return 0 - 1;
}

// Ranura que el que llama puede ver con ese pid, o -1 (no existe o es de
// otra zona; en el segundo caso queda el zone-deny).
fn proc_visible(pid: i64, nr: i64) -> i64 {
    let s = proc_find(pid);
    if (s < 0) { return 0 - 1; }
    let zc = zone_caller();
    if (zc != 0 && proc_zone[s] != zc) {
        zone_other_denied(nr);
        return 0 - 1;
    }
    return s;
}

// 25 proc_stat(pid): (pid << 8) | (zona << 4) | estado (1 listo, 2
// corriendo, 4 dormido). pid 0 es el propio. -3 si no lo ve.
fn zone_sys_pstat(pid: i64) -> i64 {
    let s = proc_visible(pid, 25);
    if (s < 0) { return 0 - 3; }
    return (proc_pid[s] << 8) | (proc_zone[s] << 4) | proc_state[s];
}

// 26 proc_kill(pid): da de baja a otro proceso (sus páginas y su cupo de
// zona vuelven). -22 si es el propio (para eso está exit), -3 si no lo ve.
fn zone_sys_pkill(pid: i64) -> i64 {
    let s = proc_visible(pid, 26);
    if (s < 0) { return 0 - 3; }
    if (s == cur_i) { return 0 - 22; }
    putc('\n');
    puts("kill pid=");
    put_int(proc_pid[s]);
    puts(" by pid=");
    put_int(proc_pid[cur_i]);
    puts("\n");
    release_proc(s);
    return 0;
}

// `zone sched nombre`: agrega a la máscara de la zona la syscall 4 (yield),
// las de procesos, 25 (proc_stat) y 26 (proc_kill), y 28 (cpu_ticks). Una zona nueva no
// cede la CPU ni ve procesos; `zone pair` lo necesita para que dos procesos
// de zonas distintas se alternen.
fn zone_sched(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    let z = zone_by_name(fs_name);
    if (z <= 0) { return zone_fail(11); }
    zone_mask[z] = zone_mask[z] | (1 << 4) | (1 << 25) | (1 << 26) | (1 << 28);
    puts("zone sched ok\n");
    return 0;
}

// `zone trace nombre`: agrega las syscalls 23 y 24 (trace_ctl, trace_read).
// Aun con ellas la zona solo lee sus propios eventos (trace.lap).
fn zone_trace(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    let z = zone_by_name(fs_name);
    if (z <= 0) { return zone_fail(11); }
    zone_mask[z] = zone_mask[z] | (1 << 23) | (1 << 24);
    puts("zone trace ok\n");
    return 0;
}

// `zone par`: escribe `par` (src/user/par.lap) en el disco.
fn zone_plant_par() -> i64 {
    let n = par_fill(exec_buf);
    if (n < 16 || n > 4096) { return exec_fail(9); }
    let r = fs_write("par", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    puts("zone par plant ok\n");
    return 0;
}

// `zone parcpu`: escribe `parcpu` (src/user/parcpu.lap) en el disco.
fn zone_plant_parcpu() -> i64 {
    let n = parcpu_fill(exec_buf);
    if (n < 16 || n > 4096) { return exec_fail(9); }
    let r = fs_write("parcpu", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    puts("zone parcpu plant ok\n");
    return 0;
}

// `zone pair za zb programa`: el mismo programa del disco dos veces a la
// vez, la copia 1 (pid 1) en la zona za y la 2 (pid 2) en la zb. Las
// reparte el planificador (yield y PIT). Imprime los contadores de
// cambios de contexto de esa corrida. za y zb pueden ser la misma zona,
// o la global ("global").
fn zone_pair_run(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    let za = zone_by_name(fs_name);
    if (za < 0) { return zone_fail(11); }
    p = fs_scan(p, fs_name);
    if (p < 0) { return zone_fail(11); }
    let zb = zone_by_name(fs_name);
    if (zb < 0) { return zone_fail(11); }
    p = fs_scan(p, fs_name);
    if (p < 0) { return zone_fail(11); }
    let entry = exec_prepare();
    if (entry == 0) { return 0; }
    if (proc_state[0] != 0 || proc_state[1] != 0) { return zone_fail(4); }
    exec_stage();
    zone_errno = 0;
    let iflags: u64 = irq_save();
    if (shared_init() == 0) {
        irq_restore(iflags);
        return zone_fail(6);
    }
    // Después de shared_init: la primera vez toma dos páginas que se quedan.
    let before = pmm_free;
    build_zone = za;
    if (exec_build(0, 0) == 0) {
        write_cr3(0x1000);
        release_proc(0);
        irq_restore(iflags);
        build_zone = 0;
        return zone_fail(zone_errno);
    }
    build_zone = zb;
    if (exec_build(1, 1) == 0) {
        write_cr3(0x1000);
        release_proc(0);
        release_proc(1);
        irq_restore(iflags);
        build_zone = 0;
        return zone_fail(zone_errno);
    }
    build_zone = 0;
    zcpu_window_start();
    zsw_n = 0;
    zsw_chg = 0;
    nswitch_timer = 0;
    nswitch_yield = 0;
    sched_go();
    irq_restore(iflags);
    puts("zone pair sw n=");
    put_int(zsw_n);
    puts(" chg=");
    put_int(zsw_chg);
    puts(" yield=");
    put_int(nswitch_yield);
    puts(" timer=");
    put_int(nswitch_timer);
    putc('\n');
    if (pmm_free != before || zone_pages[za] != 0 || zone_pages[zb] != 0) {
        puts("zone leak\n");
        return 0;
    }
    puts("zone pair ok\n");
    return 0;
}

// zone rm <nombre> <ruta>: borrado recursivo dentro de la raíz de la zona.
// La ruta es relativa a /zonas/<nombre>: no puede ser absoluta, traer
// ".", ".." ni componentes vacíos, ni quedar vacía (sería la raíz de la
// zona). Lo que pase esas pruebas va a fs_remove_tree con la ruta completa.
fn zone_rm_cmd(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    let z = zone_by_name(fs_name);
    if (z < 1) { return zone_fail(11); }
    p = fs_scanp(p, fs_path);
    if (p < 0) { return zone_fail(11); }
    let g = fs_rm_guard_rel(fs_path);
    if (g != 0) { return fs_rm_refused(20 + g); }
    // zone_path mide 64: "/zonas/" + nombre + "/" + ruta tiene que caber.
    let n = zone_root_path(z);
    let i = 0;
    while ((fs_path[i] & 255) != 0) { i = i + 1; }
    if (n + 1 + i > 63) { return zone_fail(11); }
    zone_path[n] = 47;
    n = n + 1;
    i = 0;
    while ((fs_path[i] & 255) != 0) {
        zone_path[n + i] = fs_path[i];
        i = i + 1;
    }
    zone_path[n + i] = 0;
    let r = fs_remove_tree(zone_path);
    if (r >= 21 && r <= 25) { return fs_rm_refused(r); }
    if (r != 0) { return fs_fail(r); }
    puts("zone rm ok\n");
    return 0;
}

// zone cpu <nombre> <n>: la zona puede gastar n ticks de cada ventana de 20
// (0 = sin límite; n de 1 a 20). Pone en cero sus contadores.
// zone cpu <nombre>: muestra la cuota y los contadores:
//   zone cpu <nombre> quota=<n>/20 tot=<ticks> cont=<ticks con otro listo> thr=<veces>
fn zone_cpu_cmd(pos: i64) -> i64 {
    let p = fs_scan(pos, fs_name);
    if (p < 0) { return zone_fail(11); }
    let z = zone_by_name(fs_name);
    if (z < 1) { return zone_fail(11); }
    while (p < line_len && line[p] == ' ') { p = p + 1; }
    if (p >= line_len) {
        puts("zone cpu ");
        puts(fs_name);
        puts(" quota=");
        put_int(zcpu_q[z]);
        puts("/20 tot=");
        put_int(zcpu_tot[z]);
        puts(" cont=");
        put_int(zcpu_cont[z]);
        puts(" thr=");
        put_int(zcpu_thr[z]);
        puts(" idle=");
        put_int(zcpu_idle[z]);
        puts(" solo=");
        put_int(zcpu_solo[z]);
        putc('\n');
        return 0;
    }
    if (line[p] < '0' || line[p] > '9') { return zone_fail(11); }
    parse_pos = p;
    let n = parse_int();
    if (n > 20) { return zone_fail(11); }
    zcpu_reset(z);
    zcpu_q[z] = n;
    puts("zone cpu set ");
    puts(fs_name);
    putc(' ');
    put_int(n);
    putc('\n');
    return 0;
}

fn cmd_zone() -> i64 {
    if (zone_shell() == 0) {
        puts("zone denied\n");
        return 0;
    }
    let pos = fs_scan(4, fs_sub);
    if (pos < 0) { return zone_fail(11); }
    if (fs_is("create")) { return zone_create(pos); }
    if (fs_is("destroy")) { return zone_destroy_cmd(pos); }
    if (fs_is("rm")) { return zone_rm_cmd(pos); }
    if (fs_is("cpu")) { return zone_cpu_cmd(pos); }
    if (fs_is("ls")) { return zone_ls(); }
    if (fs_is("exec")) { return zone_exec_cmd(pos); }
    if (fs_is("net")) { return zone_net(pos); }
    if (fs_is("plant")) { return zone_plant(); }
    if (fs_is("atk")) { return zone_plant_atk(); }
    if (fs_is("par")) { return zone_plant_par(); }
    if (fs_is("parcpu")) { return zone_plant_parcpu(); }
    if (fs_is("sched")) { return zone_sched(pos); }
    if (fs_is("trace")) { return zone_trace(pos); }
    if (fs_is("pair")) { return zone_pair_run(pos); }
    return zone_fail(11);
}
