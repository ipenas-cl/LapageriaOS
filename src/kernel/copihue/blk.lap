// Bloques de 512 B sobre un disco de sectores de 512 B. El bloque n vive en
// dos sectores: datos en LBA 2*n, metadatos en LBA 2*n+1.
//
// Dispositivo (HR-03). blk_rd/blk_wr mandan el sector al backend activo:
//   1 ATA   el esclavo IDE (ata.lap), como siempre
//   2 AHCI  el primer disco SATA (ahci.lap)
// blk_open elige si todavía no hay uno: ATA primero (el camino BIOS no
// cambia, aunque haya un SATA colgado) y, si no hay unidad ATA, AHCI (q35 no
// tiene IDE). blk_set_dev(n) fuerza uno; si falla, el que había sigue activo.
// blk_sectors es la capacidad del activo; 0 mientras no haya ninguno.

// Metadatos (el resto del sector va en cero):
//   0..3   magic ABLK (41 42 4C 4B)
//   4..7   número de bloque, little-endian
//   8..11  CRC-32/ISO-HDLC de los 512 bytes de datos
//
// El CRC es el de Ethernet/PNG: polinomio reflejado 0xEDB88320,
// inicio 0xFFFFFFFF, XOR final 0xFFFFFFFF. Bit a bit, sin tabla.
// El vector "123456789" da 0xCBF43926.
//
// blk_write actualiza el checksum. blk_read lo compara y, si no
// calza el magic, el número o el CRC, devuelve 5. Los otros códigos
// son los de ata.lap y ahci.lap (1 timeout, 2 ERR/DF, 3 sin unidad, 4 LBA
// malo; en AHCI 5 también es BAR/DMA inutilizable).

let blk_data: [u8; 512];
let blk_meta: [u8; 512];
let blk_raw: [u8; 512];
let blk_dev: i64 = 0;
let blk_sectors: i64 = 0;

fn blk_set_dev(d: i64) -> i64 {
    let r = 3;
    if (d == 1) {
        r = ata_identify();
        if (r == 0) {
            blk_dev = 1;
            blk_sectors = ata_sectors;
        }
    } else if (d == 2) {
        r = ahci_init();
        if (r == 0) {
            blk_dev = 2;
            blk_sectors = ahci_sectors;
        }
    }
    return r;
}

// 0 si hay backend (ya elegido o recién elegido); si no, el código del ATA.
fn blk_open() -> i64 {
    if (blk_dev != 0) { return 0; }
    let r = blk_set_dev(1);
    if (r == 0) { return 0; }
    if (blk_set_dev(2) == 0) { return 0; }
    return r;
}

fn blk_rd(lba: i64, dst: *u8) -> i64 {
    if (blk_dev == 1) { return ata_read(lba, dst); }
    if (blk_dev == 2) { return ahci_read(lba, dst); }
    return 3;
}

fn blk_wr(lba: i64, src: *u8) -> i64 {
    if (blk_dev == 1) { return ata_write(lba, src); }
    if (blk_dev == 2) { return ahci_write(lba, src); }
    return 3;
}

fn blk_dev_name() -> *u8 {
    if (blk_dev == 1) { return "ata"; }
    if (blk_dev == 2) { return "ahci"; }
    return "none";
}

// 12 bytes al frente del sector de metadatos. El resto queda en cero.
// sizeof tiene que coincidir con docs/disco.md.
packed struct BlkMeta {
    magic: [u8; 4],
    block: u32,
    crc: u32
}

fn blk_layout() -> i64 {
    if (sizeof(BlkMeta) != 12) { return 0; }
    if (offsetof(BlkMeta, magic) != 0) { return 0; }
    if (offsetof(BlkMeta, block) != 4) { return 0; }
    if (offsetof(BlkMeta, crc) != 8) { return 0; }
    return 1;
}

fn blk_mp() -> *BlkMeta {
    return blk_meta as *BlkMeta;
}

fn crc32(p: *u8, n: i64) -> i64 {
    let crc = 0xFFFFFFFF;
    let i = 0;
    while (i < n) {
        crc = crc ^ (p[i] & 255);
        let b = 0;
        while (b < 8) {
            let bit = crc & 1;
            crc = (crc >> 1) & 0x7FFFFFFF;
            if (bit != 0) { crc = crc ^ 0xEDB88320; }
            b = b + 1;
        }
        i = i + 1;
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

fn blk_range(n: i64) -> i64 {
    if (n < 0) { return 4; }
    if (blk_sectors < 2) { return 3; }
    // Cada bloque gasta dos sectores. El último par tiene que entrar.
    if (n > (blk_sectors - 2) / 2) { return 4; }
    return 0;
}

fn blk_put_meta(n: i64, sum: i64) -> i64 {
    let i = 0;
    while (i < 512) {
        blk_meta[i] = 0;
        i = i + 1;
    }
    let m: *BlkMeta = blk_mp();
    m.magic[0] = 0x41;
    m.magic[1] = 0x42;
    m.magic[2] = 0x4C;
    m.magic[3] = 0x4B;
    m.block = n as u32;
    m.crc = sum as u32;
    return 0;
}

fn blk_write(n: i64) -> i64 {
    if (blk_layout() == 0) {
        puts("blk layout\n");
        return 5;
    }
    let r = blk_range(n);
    if (r == 0) {
        let sum = crc32(blk_data, 512);
        blk_put_meta(n, sum);
        r = blk_wr(n * 2, blk_data);
        if (r == 0) { r = blk_wr(n * 2 + 1, blk_meta); }
    }
    if (tr_en[8] != 0) { trace_hit(8, proc_pid[cur_i], n, r); }
    return r;
}

fn blk_read(n: i64) -> i64 {
    if (blk_layout() == 0) {
        puts("blk layout\n");
        return 5;
    }
    let r = blk_range(n);
    if (r == 0) {
        r = blk_rd(n * 2, blk_data);
        if (r == 0) {
            r = blk_rd(n * 2 + 1, blk_meta);
            if (r == 0) {
                let m: *BlkMeta = blk_mp();
                if (m.magic[0] != 0x41 || m.magic[1] != 0x42) { r = 5; }
                else if (m.magic[2] != 0x4C || m.magic[3] != 0x4B) { r = 5; }
                else if (m.block != n) { r = 5; }
                else if (m.crc != crc32(blk_data, 512)) { r = 5; }
            }
        }
    }
    if (tr_en[7] != 0) { trace_hit(7, proc_pid[cur_i], n, r); }
    return r;
}

fn disk_say(msg: *u8, code: i64) -> i64 {
    puts(msg);
    putc(' ');
    put_int(code);
    putc('\n');
    return code;
}

// "<backend> <qué> <código>", p. ej. "ata fail 1" o "ahci fail 3".
fn disk_dev_say(what: *u8, code: i64) -> i64 {
    puts(blk_dev_name());
    putc(' ');
    puts(what);
    putc(' ');
    put_int(code);
    putc('\n');
    return code;
}

// identify, un sector de ida y vuelta, un bloque con CRC y un byte
// pisado con blk_wr (sin pasar por blk_write). Las líneas que mira
// qemu-test son: ata ok (ahci ok con el backend AHCI), blk ok, blk corrupt
// detected. Sin ningún backend: "ata fail <código del ATA>".
fn disk_test() -> i64 {
    let id = blk_open();
    if (id != 0) { return disk_say("ata fail", id); }
    if (blk_sectors < 3) { return disk_dev_say("fail", 3); }

    let i = 0;
    while (i < 512) {
        blk_raw[i] = ((i + 0x3C) & 255) as u8;
        i = i + 1;
    }
    let wr = blk_wr(2, blk_raw);
    if (wr != 0) { return disk_dev_say("fail", wr); }
    i = 0;
    while (i < 512) {
        blk_raw[i] = 0;
        i = i + 1;
    }
    let rd = blk_rd(2, blk_raw);
    if (rd != 0) { return disk_dev_say("fail", rd); }
    i = 0;
    while (i < 512) {
        if ((blk_raw[i] & 255) != ((i + 0x3C) & 255)) {
            puts(blk_dev_name());
            puts(" mismatch\n");
            return 6;
        }
        i = i + 1;
    }
    puts(blk_dev_name());
    puts(" ok\n");

    let vec: *u8 = "123456789";
    if (crc32(vec, 9) != 0xCBF43926) {
        puts("blk crc\n");
        return 6;
    }

    i = 0;
    while (i < 512) {
        blk_data[i] = ((i + 0xA5) & 255) as u8;
        i = i + 1;
    }
    let bw = blk_write(0);
    if (bw != 0) { return disk_say("blk fail", bw); }
    i = 0;
    while (i < 512) {
        blk_data[i] = 0;
        i = i + 1;
    }
    let br = blk_read(0);
    if (br != 0) { return disk_say("blk fail", br); }
    i = 0;
    while (i < 512) {
        if ((blk_data[i] & 255) != ((i + 0xA5) & 255)) {
            puts("blk mismatch\n");
            return 6;
        }
        i = i + 1;
    }
    puts("blk ok\n");

    // Salta blk: el sector de datos queda distinto y el de metadatos no.
    blk_data[100] = (blk_data[100] ^ 0xFF) & 255;
    let cw = blk_wr(0, blk_data);
    if (cw != 0) { return disk_say("blk corrupt miss", cw); }
    let cr = blk_read(0);
    if (cr == 5) {
        puts("blk corrupt detected\n");
        return 0;
    }
    return disk_say("blk corrupt miss", cr);
}

// `blk [ata|ahci]`: sin argumento elige (blk_open) y dice cuál quedó; con
// argumento (1 ATA, 2 AHCI) fuerza ese backend. Líneas: `blk dev=<ata|ahci>
// sectors=<n>`; si falla, `blk dev=<el que había>` y `blk fail <código>`.
// Cambiar de backend con un fs ya montado no es seguro: el fs no se entera.
fn blk_demo(want: i64) -> i64 {
    let r = 0;
    if (want == 0) { r = blk_open(); }
    else { r = blk_set_dev(want); }
    puts("blk dev=");
    puts(blk_dev_name());
    if (r != 0) {
        putc('\n');
        return disk_say("blk fail", r);
    }
    puts(" sectors=");
    put_int(blk_sectors);
    putc('\n');
    return 0;
}
