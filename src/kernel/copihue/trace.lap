// Trazas (OB-01), al estilo de una sonda estática.
//
// Cada sonda tiene id, nombre, contador e indicador. Apagada, el
// llamador solo compara el indicador: no entra a trace_hit. Cada una
// se prende y se apaga sola.
//
// El anillo es fijo, 64 registros (potencia de 2), sin asignación.
// Cada registro guarda tick, id de sonda, proceso, zona y dos
// argumentos. Al llenarse pisa el más viejo y sube `tr_lost`.
//
// Dentro de una interrupción no se puede hacer sti() a ciegas: el
// syscall llega con IF en 0 (SFMASK) y el PIT también. trace_save_if
// es irq_save() (lee RFLAGS y hace cli) y trace_restore_if es
// irq_restore con esos flags. Un anidamiento (una #PF en
// medio del registro) deja los flags en una pila corta y, si el
// anillo ya está tomado, cuenta el evento como perdido y sale. No
// hay espera: no se cuelga. El registro es TrEv; trace_layout exige
// 48 bytes y los campos en 0, 8, 16, 24, 32 y 40.
//
// Desde anillo 3: syscall 23 (trace_ctl) y 24 (trace_read). Ver
// docs/trace.md. El programa `traza` (src/user/traza.lap) las usa.

//  0 sys-enter   1 sys-exit    2 switch      3 pf          4 pit
//  5 pg-alloc    6 pg-free     7 blk-read    8 blk-write   9 net-rx
// 10 net-tx     11 irq-kbd    12 irq-net    13 udp-rx     14 udp-tx
// 15 tcp-state  16 tcp-retx   17 tcp-rst    18 zone-switch 19 zone-deny
struct TrEv {
    time: i64,
    id: i64,
    pid: i64,
    zone: i64,
    a0: i64,
    a1: i64
}

let tr_ring: [TrEv; 64];
let tr_en: [i64; 20];
let tr_count: [i64; 20];
let tr_show: [i64; 384];
let tr_word: [u8; 16];
let tr_req: [u8; 8];
let tr_fl_stk: [i64; 4];
let volatile tr_fl_tmp: i64 = 0;
let volatile tr_fl_sp: i64 = 0;
let volatile tr_busy: i64 = 0;
let volatile tr_head: i64 = 0;
let volatile tr_used: i64 = 0;
let volatile tr_lost: i64 = 0;

fn trace_save_if() {
    tr_fl_tmp = irq_save() as i64;
}

fn trace_restore_if() {
    irq_restore(tr_fl_tmp as u64);
}

fn trace_unlock_flags() -> i64 {
    if (tr_fl_sp <= 0) { return 0; }
    tr_fl_sp = tr_fl_sp - 1;
    tr_fl_tmp = tr_fl_stk[tr_fl_sp];
    trace_restore_if();
    return 0;
}

// Deja el anillo tomado y las IRQ como estaban. 0 = no se pudo: el
// evento ya quedó en tr_lost y las IRQ volvieron a su estado.
fn trace_lock() -> i64 {
    trace_save_if();
    if (tr_fl_sp >= 4) {
        tr_lost = tr_lost + 1;
        trace_restore_if();
        return 0;
    }
    tr_fl_stk[tr_fl_sp] = tr_fl_tmp;
    tr_fl_sp = tr_fl_sp + 1;
    if (tr_busy != 0) {
        tr_lost = tr_lost + 1;
        trace_unlock_flags();
        return 0;
    }
    tr_busy = 1;
    return 1;
}

fn trace_unlock() -> i64 {
    tr_busy = 0;
    return trace_unlock_flags();
}

fn trace_layout() -> i64 {
    if (sizeof(TrEv) != 48) { return 0; }
    if (offsetof(TrEv, time) != 0) { return 0; }
    if (offsetof(TrEv, id) != 8) { return 0; }
    if (offsetof(TrEv, pid) != 16) { return 0; }
    if (offsetof(TrEv, zone) != 24) { return 0; }
    if (offsetof(TrEv, a0) != 32) { return 0; }
    if (offsetof(TrEv, a1) != 40) { return 0; }
    return 1;
}

// La zona se pasa explícita (switch_to: la del proceso que sale).
fn trace_hit_z(id: i64, pid: i64, zone: i64, a0: i64, a1: i64) -> i64 {
    if (id < 0 || id >= 20) { return 0; }
    if (tr_en[id] == 0) { return 0; }
    if (trace_lock() == 0) { return 0; }
    tr_count[id] = tr_count[id] + 1;
    let slot = tr_head & 63;
    tr_ring[slot].time = ticks;
    tr_ring[slot].id = id;
    tr_ring[slot].pid = pid;
    tr_ring[slot].zone = zone;
    tr_ring[slot].a0 = a0;
    tr_ring[slot].a1 = a1;
    tr_head = (slot + 1) & 63;
    if (tr_used < 64) { tr_used = tr_used + 1; }
    else { tr_lost = tr_lost + 1; }
    trace_unlock();
    return 0;
}

// Zona y pid son los del proceso que corre; 0 y 0 si el planificador está apagado
// (shell, o IRQ entre dos `exec`).
fn trace_hit(id: i64, pid: i64, a0: i64, a1: i64) -> i64 {
    if (sched_on == 0) { return trace_hit_z(id, 0, 0, a0, a1); }
    return trace_hit_z(id, pid, proc_zone[cur_i], a0, a1);
}

fn tr_name(id: i64) -> *u8 {
    if (id == 0) { return "sys-enter"; }
    if (id == 1) { return "sys-exit"; }
    if (id == 2) { return "switch"; }
    if (id == 3) { return "pf"; }
    if (id == 4) { return "pit"; }
    if (id == 5) { return "pg-alloc"; }
    if (id == 6) { return "pg-free"; }
    if (id == 7) { return "blk-read"; }
    if (id == 8) { return "blk-write"; }
    if (id == 9) { return "net-rx"; }
    if (id == 10) { return "net-tx"; }
    if (id == 11) { return "irq-kbd"; }
    if (id == 12) { return "irq-net"; }
    if (id == 13) { return "udp-rx"; }
    if (id == 14) { return "udp-tx"; }
    if (id == 15) { return "tcp-state"; }
    if (id == 16) { return "tcp-retx"; }
    if (id == 17) { return "tcp-rst"; }
    if (id == 18) { return "zone-switch"; }
    if (id == 19) { return "zone-deny"; }
    return "?";
}

// tr_word[off..] es igual a s.
fn tr_is_at(s: *u8, off: i64) -> i64 {
    let i = 0;
    while (s[i] != 0) {
        if (tr_word[off + i] != s[i]) { return 0; }
        i = i + 1;
    }
    return tr_word[off + i] == 0;
}

fn tr_is(s: *u8) -> i64 {
    return tr_is_at(s, 0);
}

fn tr_find_at(off: i64) -> i64 {
    let id = 0;
    while (id < 20) {
        if (tr_is_at(tr_name(id), off) != 0) { return id; }
        id = id + 1;
    }
    return 0 - 1;
}

fn tr_find() -> i64 {
    return tr_find_at(0);
}

fn tr_word_at(pos: i64) -> i64 {
    while (pos < line_len && line[pos] == 32) { pos = pos + 1; }
    let i = 0;
    while (i < 16) { tr_word[i] = 0; i = i + 1; }
    i = 0;
    while (pos < line_len && line[pos] != 32 && i < 15) {
        tr_word[i] = line[pos];
        i = i + 1;
        pos = pos + 1;
    }
    return pos;
}

// Vacía el anillo, los perdidos y los contadores. 0 si lo hizo.
fn trace_reset() -> i64 {
    if (trace_lock() == 0) { return 0 - 16; }
    tr_head = 0;
    tr_used = 0;
    tr_lost = 0;
    let i = 0;
    while (i < 20) {
        tr_count[i] = 0;
        i = i + 1;
    }
    trace_unlock();
    return 0;
}

fn trace_clear() -> i64 {
    if (trace_reset() != 0) {
        puts("trace busy\n");
        return 0;
    }
    puts("trace clear\n");
    return 0;
}

fn trace_ls() -> i64 {
    if (trace_lock() == 0) {
        puts("trace busy\n");
        return 0;
    }
    let lost = tr_lost;
    let i = 0;
    while (i < 20) {
        tr_show[i] = tr_count[i];
        tr_show[i + 20] = tr_en[i];
        i = i + 1;
    }
    trace_unlock();
    i = 0;
    while (i < 20) {
        put_int(i);
        putc(32);
        puts(tr_name(i));
        putc(32);
        if (tr_show[i + 20] != 0) { puts("on"); } else { puts("off"); }
        putc(32);
        put_int(tr_show[i]);
        putc(10);
        i = i + 1;
    }
    puts("trace lost ");
    put_int(lost);
    putc(10);
    return 0;
}

fn trace_count() -> i64 {
    if (trace_lock() == 0) {
        puts("trace busy\n");
        return 0;
    }
    let lost = tr_lost;
    let i = 0;
    while (i < 20) {
        tr_show[i] = tr_count[i];
        i = i + 1;
    }
    trace_unlock();
    puts("trace count lost ");
    put_int(lost);
    putc(10);
    i = 0;
    while (i < 20) {
        puts("probe ");
        puts(tr_name(i));
        putc(32);
        put_int(tr_show[i]);
        putc(10);
        i = i + 1;
    }
    return 0;
}

fn trace_dump(n: i64) -> i64 {
    if (trace_lock() == 0) {
        puts("trace busy\n");
        return 0;
    }
    let used = tr_used;
    let lost = tr_lost;
    if (used < 0) { used = 0; }
    if (used > 64) { used = 64; }
    if (n <= 0 || n > used) { n = used; }
    let idx = 0;
    if (used == 64) { idx = tr_head & 63; }
    let skip = used - n;
    let s = 0;
    while (s < skip) {
        idx = (idx + 1) & 63;
        s = s + 1;
    }
    let k = 0;
    while (k < n) {
        tr_show[k * 6] = tr_ring[idx].time;
        tr_show[k * 6 + 1] = tr_ring[idx].id;
        tr_show[k * 6 + 2] = tr_ring[idx].pid;
        tr_show[k * 6 + 3] = tr_ring[idx].a0;
        tr_show[k * 6 + 4] = tr_ring[idx].a1;
        tr_show[k * 6 + 5] = tr_ring[idx].zone;
        idx = (idx + 1) & 63;
        k = k + 1;
    }
    trace_unlock();
    puts("trace begin\n");
    k = 0;
    while (k < n) {
        puts("t ");
        put_int(tr_show[k * 6]);
        putc(32);
        puts(tr_name(tr_show[k * 6 + 1]));
        puts(" pid ");
        put_int(tr_show[k * 6 + 2]);
        puts(" a ");
        put_int(tr_show[k * 6 + 3]);
        puts(" b ");
        put_int(tr_show[k * 6 + 4]);
        puts(" z ");
        put_int(tr_show[k * 6 + 5]);
        putc(10);
        k = k + 1;
    }
    puts("trace end n ");
    put_int(n);
    puts(" lost ");
    put_int(lost);
    putc(10);
    return 0;
}

fn trace_set(on: i64) -> i64 {
    let id = tr_find();
    if (id < 0) {
        puts("trace bad probe\n");
        return 0;
    }
    if (on != 0) { tr_en[id] = 1; } else { tr_en[id] = 0; }
    puts("trace ");
    if (on != 0) { puts("on "); } else { puts("off "); }
    puts(tr_name(id));
    putc(10);
    return 0;
}

// ---- Syscalls 23 y 24 (anillo 3) ----------------------------------

// 23 trace_ctl(op, a, b)
//   0 set    a = sonda (255 = todas), b = 0/1       -> 0
//   1 get    a = sonda                              -> (contador << 1) | encendida
//   2 clear                                         -> 0
//   3 info                                          -> usados | (perdidos << 8)
//   4 nprobes                                       -> 20
//   5 name   a = sonda, b = puntero de escritura de 16 bytes -> largo
// Errores: -22 argumento, -14 puntero, -16 anillo tomado.
fn trace_sys_ctl(op: i64, a: i64, b: i64) -> i64 {
    if (op == 0) {
        if (a == 255) {
            let i = 0;
            while (i < 20) {
                if (b != 0) { tr_en[i] = 1; } else { tr_en[i] = 0; }
                i = i + 1;
            }
            return 0;
        }
        if (a < 0 || a >= 20) { return 0 - 22; }
        if (b != 0) { tr_en[a] = 1; } else { tr_en[a] = 0; }
        return 0;
    }
    if (op == 1) {
        if (a < 0 || a >= 20) { return 0 - 22; }
        return (tr_count[a] << 1) | tr_en[a];
    }
    if (op == 2) { return trace_reset(); }
    if (op == 3) {
        if (trace_lock() == 0) { return 0 - 16; }
        let r = tr_used | (tr_lost << 8);
        trace_unlock();
        return r;
    }
    if (op == 4) { return 20; }
    if (op == 5) {
        if (a < 0 || a >= 20) { return 0 - 22; }
        if (uptr_range_ok(b, 16, 1) == 0) { return 0 - 14; }
        let s: *u8 = tr_name(a);
        let d: *u8 = b as *u8;
        let n = 0;
        while (s[n] != 0 && n < 15) {
            d[n] = s[n];
            n = n + 1;
        }
        d[n] = 0;
        return n;
    }
    return 0 - 22;
}

// El registro slot pasa el filtro sel: bits 0..7 sonda + 1, bits 8..15
// zona + 1, bits 16..39 pid + 1. Un campo en 0 no filtra.
fn tr_match(slot: i64, sel: i64) -> i64 {
    let e = sel & 255;
    if (e != 0 && tr_ring[slot].id != e - 1) { return 0; }
    let z = (sel >> 8) & 255;
    if (z != 0 && tr_ring[slot].zone != z - 1) { return 0; }
    let p = (sel >> 16) & 0xFFFFFF;
    if (p != 0 && tr_ring[slot].pid != p - 1) { return 0; }
    return 1;
}

// 24 trace_read(buf, max, sel): copia a buf hasta max (1..32) registros
// que pasan el filtro sel, los más nuevos, del más viejo al más nuevo.
// Cada registro son 6 i64: tick, sonda, pid, zona, a, b (48 bytes).
// Devuelve cuántos. buf tiene que caer en las páginas de escritura del
// proceso (como UDP y TCP). -22 argumento, -14 puntero, -16 tomado.
fn trace_sys_read(buf: i64, max: i64, sel: i64) -> i64 {
    if (max < 1 || max > 32) { return 0 - 22; }
    if (sel < 0) { return 0 - 22; }
    if (uptr_range_ok(buf, max * 48, 1) == 0) { return 0 - 14; }
    if (trace_lock() == 0) { return 0 - 16; }
    let used = tr_used;
    if (used > 64) { used = 64; }
    let first = 0;
    if (used == 64) { first = tr_head & 63; }
    let m = 0;
    let i = 0;
    let k = first;
    while (i < used) {
        m = m + tr_match(k, sel);
        k = (k + 1) & 63;
        i = i + 1;
    }
    let skip = m - max;
    if (skip < 0) { skip = 0; }
    let out = 0;
    let seen = 0;
    i = 0;
    k = first;
    while (i < used) {
        if (tr_match(k, sel) != 0) {
            if (seen >= skip) {
                tr_show[out * 6] = tr_ring[k].time;
                tr_show[out * 6 + 1] = tr_ring[k].id;
                tr_show[out * 6 + 2] = tr_ring[k].pid;
                tr_show[out * 6 + 3] = tr_ring[k].zone;
                tr_show[out * 6 + 4] = tr_ring[k].a0;
                tr_show[out * 6 + 5] = tr_ring[k].a1;
                out = out + 1;
            }
            seen = seen + 1;
        }
        k = (k + 1) & 63;
        i = i + 1;
    }
    trace_unlock();
    let dst: *i64 = buf as *i64;
    let j = 0;
    while (j < out * 6) {
        dst[j] = tr_show[j];
        j = j + 1;
    }
    return out;
}

// ---- Shell ---------------------------------------------------------

// `trace plant`: escribe el programa traza en el disco.
fn trace_plant() -> i64 {
    let n = traza_fill(exec_buf);
    if (n < 16 || n > 4096) { return exec_fail(9); }
    let r = fs_write("traza", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    puts("trace plant ok\n");
    return 0;
}

// Número decimal en tr_word a partir de off.
fn tr_num_at(off: i64) -> i64 {
    let v = 0;
    while (tr_word[off] >= '0' && tr_word[off] <= '9') {
        v = v * 10 + (tr_word[off] - '0');
        off = off + 1;
    }
    return v;
}

fn traza_usage() -> i64 {
    puts("traza: ls | count | clear | ptr | zone <n> | on|off <sonda|all> | dump [ev=<sonda>] [zone=<n>] [pid=<n>] [n=<k>]\n");
    return 0;
}

// `traza ...`: arma la petición de 8 bytes en el archivo tzq y corre el
// programa traza del disco (anillo 3), que la lee con la syscall 7.
//   [0] l ls  c count  x clear  p ptr  o on  f off  d dump
//   [1] sonda (255 = todas)   [2] sonda + 1   [3] zona + 1
//   [4] pid + 1               [5] n (1..32)
fn cmd_traza() -> i64 {
    let i = 0;
    while (i < 8) { tr_req[i] = 0; i = i + 1; }
    let pos = tr_word_at(6);
    if (tr_word[0] == 0 || tr_is("ls") != 0) { tr_req[0] = 'l'; }
    else if (tr_is("count") != 0) { tr_req[0] = 'c'; }
    else if (tr_is("clear") != 0) { tr_req[0] = 'x'; }
    else if (tr_is("ptr") != 0) { tr_req[0] = 'p'; }
    else if (tr_is("on") != 0 || tr_is("off") != 0) {
        if (tr_is("on") != 0) { tr_req[0] = 'o'; } else { tr_req[0] = 'f'; }
        tr_word_at(pos);
        if (tr_is("all") != 0) { tr_req[1] = 255; }
        else {
            let id = tr_find();
            if (id < 0) {
                puts("trace bad probe\n");
                return 0;
            }
            tr_req[1] = id as u8;
        }
    }
    else if (tr_is("zone") != 0) {
        tr_req[0] = 'z';
        tr_word_at(pos);
        tr_req[1] = tr_num_at(0) as u8;
    }
    else if (tr_is("dump") != 0) {
        tr_req[0] = 'd';
        tr_req[5] = 16;
        while (1) {
            pos = tr_word_at(pos);
            if (tr_word[0] == 0) { break; }
            if (tr_word[0] == 'e' && tr_word[1] == 'v' && tr_word[2] == '=') {
                let id = tr_find_at(3);
                if (id < 0) {
                    puts("trace bad probe\n");
                    return 0;
                }
                tr_req[2] = (id + 1) as u8;
            }
            else if (tr_word[0] == 'z' && tr_word[1] == 'o' && tr_word[2] == 'n' && tr_word[3] == 'e' && tr_word[4] == '=') {
                tr_req[3] = (tr_num_at(5) + 1) as u8;
            }
            else if (tr_word[0] == 'p' && tr_word[1] == 'i' && tr_word[2] == 'd' && tr_word[3] == '=') {
                tr_req[4] = (tr_num_at(4) + 1) as u8;
            }
            else if (tr_word[0] == 'n' && tr_word[1] == '=') {
                let k = tr_num_at(2);
                if (k < 1 || k > 32) { return traza_usage(); }
                tr_req[5] = k as u8;
            }
            else { return traza_usage(); }
        }
    }
    else { return traza_usage(); }
    let r = fs_write("tzq", tr_req, 8);
    if (r != 0) {
        puts("traza fail ");
        put_int(r);
        putc(10);
        return 0;
    }
    fs_zero(fs_name, 16);
    fs_copy(fs_name, "traza", 6);
    return exec_run();
}

fn cmd_trace() -> i64 {
    if (trace_layout() == 0) {
        puts("trace layout\n");
        return 0;
    }
    let pos = tr_word_at(5);
    if (tr_word[0] == 0 || tr_is("ls") != 0) { return trace_ls(); }
    if (tr_is("count") != 0) { return trace_count(); }
    if (tr_is("clear") != 0) { return trace_clear(); }
    if (tr_is("plant") != 0) { return trace_plant(); }
    if (tr_is("dump") != 0) {
        while (pos < line_len && line[pos] == 32) { pos = pos + 1; }
        if (pos >= line_len) { return trace_dump(0); }
        parse_pos = pos;
        return trace_dump(parse_int());
    }
    if (tr_is("on") != 0 || tr_is("off") != 0) {
        let on = tr_is("on");
        tr_word_at(pos);
        return trace_set(on);
    }
    puts("trace bad cmd\n");
    return 0;
}
